<Window x:Class="ArchivePassword.Desktop.ArchiveTextEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" Style="{StaticResource AppWindow}" Title="{loc:Text TextEdit.EditorTitle}" Width="800" Height="620" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="{DynamicResource SurfaceBrush}" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,20"><StackPanel><TextBlock x:Name="FileNameLabel" Style="{StaticResource PageTitle}"/><TextBlock x:Name="EncodingLabel" Style="{StaticResource Secondary}" Margin="0,6,0,0"/></StackPanel></Border>
    <TextBox x:Name="Editor" Grid.Row="1" Margin="24,18" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="OnTextChanged" AutomationProperties.Name="{loc:Text TextEdit.EditorTitle}"/>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><WrapPanel Grid.Column="1"><Button x:Name="WriteBackButton" Content="{loc:Text TextEdit.WriteBack}" Style="{StaticResource PrimaryButton}" Click="OnWriteBack" Margin="0,0,12,0" MinHeight="40"/><Button Content="{loc:Text TextEdit.Discard}" IsCancel="True" MinHeight="40"/></WrapPanel></Grid></Border>
  </Grid>
</Window>
