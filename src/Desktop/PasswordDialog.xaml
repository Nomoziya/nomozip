<Window x:Class="ArchivePassword.Desktop.PasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="输入解压密码" Width="480" Height="560" MinHeight="420" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="Heading" Text="输入解压密码" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
      <StackPanel x:Name="FailurePanel" Visibility="Collapsed" Margin="0,0,0,16"><TextBlock x:Name="FailureSummary" TextWrapping="Wrap"/><Button Content="查看失败条目" Click="OnShowFailures" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="查看上一次验证失败的条目"/></StackPanel>
      <StackPanel x:Name="SavedPanel" Margin="0,0,0,16"><Label Content="选择已保存的密码" Target="{Binding ElementName=SavedBox}" Padding="0"/><ComboBox x:Name="SavedBox" DisplayMemberPath="Name" Margin="0,8,0,0" SelectionChanged="SavedChanged" AutomationProperties.Name="选择已保存的密码"/></StackPanel>
      <Label Content="密码" Target="{Binding ElementName=SecretBox}" Padding="0"/>
      <Grid Margin="0,8,0,0"><PasswordBox x:Name="SecretBox" PasswordChanged="SecretChanged" AutomationProperties.Name="密码"/><TextBox x:Name="VisibleSecret" Visibility="Collapsed" AutomationProperties.Name="密码，当前显示明文"/></Grid>
      <CheckBox x:Name="ShowPassword" Content="显示密码" Checked="VisibilityChanged" Unchecked="VisibilityChanged"/>
      <CheckBox x:Name="SavePassword" Content="成功后保存到密码库" Checked="SaveChanged" Unchecked="SaveChanged"/>
      <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
        <Label Content="名称" Target="{Binding ElementName=NameBox}" Padding="0"/><TextBox x:Name="NameBox" Margin="0,8,0,16" AutomationProperties.Name="密码名称"/>
        <StackPanel x:Name="EditorDetails">
          <Label Content="分组（可选）" Target="{Binding ElementName=GroupBox}" Padding="0"/><TextBox x:Name="GroupBox" MaxLength="128" Margin="0,8,0,16" AutomationProperties.Name="密码分组"/>
          <Label Content="来源（可选）" Target="{Binding ElementName=SourceBox}" Padding="0"/><TextBox x:Name="SourceBox" MaxLength="512" Margin="0,8,0,16" AutomationProperties.Name="密码来源"/>
          <Expander Header="优先尝试规则（可选）" Margin="0,0,0,16"><StackPanel Margin="0,8,0,0"><Label Content="压缩包文件名包含" Target="{Binding ElementName=MatchBox}" Padding="0"/><TextBox x:Name="MatchBox" MaxLength="256" Margin="0,8,0,8" AutomationProperties.Name="优先尝试的文件名关键词"/><TextBlock Text="例如“照片”。不区分大小写；仅调整顺序，其它已启用密码仍会尝试。留空则不设规则。" Style="{StaticResource Secondary}" TextWrapping="Wrap"/></StackPanel></Expander>
          <Label Content="备注" Target="{Binding ElementName=NotesBox}" Padding="0"/><TextBox x:Name="NotesBox" Margin="0,8,0,8" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" AutomationProperties.Name="密码备注"/><CheckBox x:Name="AutoTryBox" Content="解压时自动尝试此密码" IsChecked="True"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,12,0"/><Button x:Name="ContinueButton" Content="继续解压" IsDefault="True" Click="OnContinue" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
