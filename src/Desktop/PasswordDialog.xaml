<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.PasswordDialog" Style="{StaticResource AppWindow}" Title="{loc:Text T_0b848fcf77fa}" Width="560" Height="Auto" MinHeight="340" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" MinWidth="480" SizeToContent="Height">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,24">
            <loc:FluentIcon Kind="Key" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" DockPanel.Dock="Left"/>
            <TextBlock x:Name="Heading" Text="{loc:Text T_0b848fcf77fa}" Margin="0" VerticalAlignment="Center" Style="{StaticResource PageTitle}"/>
          </DockPanel>
          <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
          <Border x:Name="RetryBanner" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0" HorizontalAlignment="Left">

                <loc:FluentIcon Kind="Warning" Foreground="{DynamicResource WarningTextBrush}"/>
              </Grid>
              <TextBlock x:Name="RetryMessage" Grid.Column="1" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
          </Border>
          <StackPanel x:Name="FailurePanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock x:Name="FailureSummary" TextWrapping="Wrap"/>
            <Button Content="{loc:Text T_7d59743b0281}" Click="OnShowFailures" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{loc:Text T_fbac9a59ad82}"/>
          </StackPanel>
          <StackPanel x:Name="SavedPanel" Margin="0,0,0,16">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_9a7734609eda}" Target="{Binding ElementName=SavedBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <ComboBox x:Name="SavedBox" DisplayMemberPath="Name" Margin="0" SelectionChanged="SavedChanged" AutomationProperties.Name="{loc:Text T_9a7734609eda}" Grid.Column="1"/>
            </Grid>
          </StackPanel>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="{loc:Text T_a621ab606db2}" Target="{Binding ElementName=SecretBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <Grid Margin="0" Grid.Column="1">
              <PasswordBox x:Name="SecretBox" PasswordChanged="SecretChanged" AutomationProperties.Name="{loc:Text T_a621ab606db2}" Padding="8,6,40,6"/>
              <TextBox x:Name="VisibleSecret" Visibility="Collapsed" AutomationProperties.Name="{loc:Text T_1513262149a4}" Padding="8,6,40,6"/>
              <ToggleButton Style="{StaticResource SecretRevealToggle}" IsChecked="{Binding IsChecked,ElementName=ShowPassword,Mode=TwoWay}" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{loc:Text T_ffe21a671190}" AutomationProperties.Name="{loc:Text T_ffe21a671190}"/>
            </Grid>
          </Grid>
          <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text Password.Confirm}" Target="{Binding ElementName=ConfirmationBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <Grid Margin="0" Grid.Column="1">
                <PasswordBox x:Name="ConfirmationBox" PasswordChanged="SecretChanged" AutomationProperties.Name="{loc:Text Password.Confirm}" Padding="8,6,40,6"/>
                <TextBox x:Name="VisibleConfirmation" Visibility="Collapsed" AutomationProperties.Name="{loc:Text Password.Confirm}" Padding="8,6,40,6"/>
                <ToggleButton Style="{StaticResource SecretRevealToggle}" IsChecked="{Binding IsChecked,ElementName=ShowPassword,Mode=TwoWay}" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{loc:Text T_ffe21a671190}" AutomationProperties.Name="{loc:Text T_ffe21a671190}"/>
              </Grid>
            </Grid>
          </StackPanel>
          <CheckBox x:Name="ShowPassword" Content="{loc:Text T_ffe21a671190}" Checked="VisibilityChanged" Unchecked="VisibilityChanged" Margin="112,4,0,4"/>
          <StackPanel x:Name="CompressionHeadersPanel" Margin="112,0,0,8" Visibility="Collapsed">
            <CheckBox x:Name="EncryptHeadersBox" Content="{loc:Text T_6df0322e460d}" Margin="0,4,0,4"/>
            <TextBlock Text="{loc:Text Compression.HeadersHint}" Style="{StaticResource Secondary}" Margin="24,0,0,0"/>
          </StackPanel>
          <CheckBox x:Name="SavePassword" Content="{loc:Text T_dce9d4fb756a}" Checked="SaveChanged" Unchecked="SaveChanged" Margin="112,4,0,4"/>
          <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_d44e9b3d3b31}" Target="{Binding ElementName=NameBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <TextBox x:Name="NameBox" Margin="0" AutomationProperties.Name="{loc:Text T_248fdf1896ba}" Grid.Column="1"/>
            </Grid>
            <StackPanel x:Name="EditorDetails">
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text T_d4163ce3b078}" Target="{Binding ElementName=GroupBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <TextBox x:Name="GroupBox" MaxLength="128" Margin="0" AutomationProperties.Name="{loc:Text T_fcc639129b23}" Grid.Column="1"/>
              </Grid>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text T_b5bb08da76d9}" Target="{Binding ElementName=SourceBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <TextBox x:Name="SourceBox" MaxLength="512" Margin="0" AutomationProperties.Name="{loc:Text T_b265ade249fc}" Grid.Column="1"/>
              </Grid>
              <Expander Header="{loc:Text T_abab7359518e}" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0">
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="112"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="{loc:Text T_724d7a12cc56}" Target="{Binding ElementName=MatchBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                      <Label.ContentTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                      </Label.ContentTemplate>
                    </Label>
                    <TextBox x:Name="MatchBox" MaxLength="256" Margin="0" AutomationProperties.Name="{loc:Text T_f3c637218750}" Grid.Column="1"/>
                  </Grid>
                  <Label Content="{loc:Text Password.DirectoryRule}" Target="{Binding ElementName=DirectoryMatchBox}"/>
                  <TextBox x:Name="DirectoryMatchBox" MaxLength="1024" AutomationProperties.Name="{loc:Text Password.DirectoryRule}" ToolTip="{loc:Text Password.DirectoryHint}" Margin="0,0,0,8"/>
                  <TextBlock Text="{loc:Text Password.DirectoryHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Text="{loc:Text T_d3fcfb571828}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                </StackPanel>
              </Expander>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text T_daede9881787}" Target="{Binding ElementName=NotesBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <TextBox x:Name="NotesBox" Margin="0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" AutomationProperties.Name="{loc:Text T_9c337a89dac9}" Grid.Column="1"/>
              </Grid>
              <CheckBox x:Name="AutoTryBox" Content="{loc:Text T_a3610c2b94b0}" IsChecked="True"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
          <Button x:Name="ContinueButton" Content="{loc:Text T_959216b78f90}" IsDefault="True" Click="OnContinue" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" MinWidth="144" MinHeight="40"/>
          <Button x:Name="CancelButton" Content="{loc:Text T_2cd0f3be8738}" IsCancel="True" Margin="0" MinWidth="144" MinHeight="40"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
