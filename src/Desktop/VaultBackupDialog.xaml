<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" x:Class="ArchivePassword.Desktop.VaultBackupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Width="480" Height="470" MinWidth="360" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
      <TextBlock x:Name="FileLabel" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <Label Content="{loc:Text T_84cffd4304ee}" Target="{Binding ElementName=SecretBox}" Padding="0"/>
      <PasswordBox x:Name="SecretBox" AutomationProperties.Name="{loc:Text T_84cffd4304ee}" Margin="0,8,0,16" PasswordChanged="SecretChanged"/>
      <StackPanel x:Name="ConfirmationPanel"><Label Content="{loc:Text T_bff03461df20}" Target="{Binding ElementName=ConfirmationBox}" Padding="0"/><PasswordBox x:Name="ConfirmationBox" AutomationProperties.Name="{loc:Text T_bff03461df20}" Margin="0,8,0,16" PasswordChanged="SecretChanged"/></StackPanel>
      <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{loc:Text T_2cd0f3be8738}" IsCancel="True" Margin="0,0,12,0"/><Button x:Name="ContinueButton" IsDefault="True" Click="OnContinue" Style="{StaticResource PrimaryButton}"/></WrapPanel>
  </Grid>
</Window>
