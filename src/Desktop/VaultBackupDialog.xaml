<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.VaultBackupDialog" Style="{StaticResource AppWindow}" Width="560" Height="Auto" MinWidth="480" MinHeight="340" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" SizeToContent="Height">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,24">
            <Viewbox Width="30" Height="36" DockPanel.Dock="Left" Margin="0,0,16,0">
              <Grid Width="30" Height="36">
                <Path Data="M2,1 L19,1 L28,10 L28,35 L2,35 Z" Fill="{DynamicResource AccentBrush}"/>
                <Path Data="M19,1 L19,10 L28,10 M11,23 L11,19 A4,4 0 0 1 19,19 L19,23 M9,23 L21,23 L21,33 L9,33 Z M15,26 L15,30" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
              </Grid>
            </Viewbox>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
          <TextBlock x:Name="FileLabel" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="136"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="{loc:Text T_84cffd4304ee}" Target="{Binding ElementName=SecretBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <Grid Grid.Column="1">
              <PasswordBox x:Name="SecretBox" AutomationProperties.Name="{loc:Text T_84cffd4304ee}" Margin="0" PasswordChanged="SecretChanged" Padding="8,6,40,6"/>
              <TextBox x:Name="VisibleSecret" Visibility="Collapsed" Padding="8,6,40,6" MaxLength="16384"/>
              <ToggleButton x:Name="RevealToggle" Style="{StaticResource SecretRevealToggle}" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{loc:Text T_ffe21a671190}" AutomationProperties.Name="{loc:Text T_ffe21a671190}"/>
            </Grid>
          </Grid>
          <StackPanel x:Name="ConfirmationPanel">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_bff03461df20}" Target="{Binding ElementName=ConfirmationBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <Grid Grid.Column="1">
                <PasswordBox x:Name="ConfirmationBox" AutomationProperties.Name="{loc:Text T_bff03461df20}" Margin="0" PasswordChanged="SecretChanged" Padding="8,6,40,6"/>
                <TextBox x:Name="VisibleConfirmation" Visibility="Collapsed" Padding="8,6,40,6" MaxLength="16384"/>
                <ToggleButton IsChecked="{Binding IsChecked,ElementName=RevealToggle,Mode=TwoWay}" Style="{StaticResource SecretRevealToggle}" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{loc:Text T_ffe21a671190}" AutomationProperties.Name="{loc:Text T_ffe21a671190}"/>
              </Grid>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
        <WrapPanel HorizontalAlignment="Right" Margin="0">
          <Button x:Name="ContinueButton" IsDefault="True" Click="OnContinue" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" MinWidth="144" MinHeight="40"/>
          <Button Content="{loc:Text T_2cd0f3be8738}" IsCancel="True" Margin="0" MinWidth="144" MinHeight="40"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</Window>
