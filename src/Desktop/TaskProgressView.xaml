<UserControl x:Class="ArchivePassword.Desktop.TaskProgressView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArchivePassword.Desktop" Focusable="False" IsHitTestVisible="False">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIfTrue"/></UserControl.Resources>
  <StackPanel Margin="12,0" VerticalAlignment="Center">
    <DockPanel Margin="0,0,0,6">
      <TextBlock x:Name="Percentage" DockPanel.Dock="Right" Text="{Binding DisplayedValue,ElementName=Track,StringFormat={}{0:0}%}" Margin="8,0,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsIndeterminate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Running}" Value="False"/><Condition Binding="{Binding Completed}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <local:TaskProgressRing x:Name="Ring" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0" Value="{Binding DisplayedValue,ElementName=Track}" Foreground="{Binding Foreground,ElementName=Track}"><local:TaskProgressRing.Style><Style TargetType="local:TaskProgressRing"><Style.Triggers><DataTrigger Binding="{Binding IsIndeterminate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:TaskProgressRing.Style></local:TaskProgressRing>
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
    </DockPanel>
    <local:TaskProgressTrack x:Name="Track" Height="6" Value="{Binding DisplayPercent}" Background="{DynamicResource DividerBrush}" IsRunning="{Binding Running}">
      <local:TaskProgressTrack.Style><Style TargetType="local:TaskProgressTrack"><Setter Property="IsPaused" Value="{Binding Paused}"/><Setter Property="Visibility" Value="{Binding ProgressVisibility}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Paused}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding StateKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsQueuePaused,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="IsPaused" Value="True"/></DataTrigger><DataTrigger Binding="{Binding IsIndeterminate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:TaskProgressTrack.Style>
    </local:TaskProgressTrack>
  </StackPanel>
</UserControl>
