<Window x:Class="ArchivePassword.Desktop.ArchiveEditConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" Style="{StaticResource AppWindow}" Width="640" Height="390" MinWidth="500" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource SurfaceBrush}"><Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,28"><Path x:Name="ActionIcon" Data="M3,1 L16,1 L23,8 L23,30 L3,30 Z M16,1 L16,8 L23,8 M8,21 L17,12 L20,15 L11,24 L7,25 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Width="29" Height="34" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1">
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource CanvasBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,18,0" Height="70"><Path Data="M2,1 L16,1 L23,8 L23,29 L2,29 Z M16,1 L16,8 L23,8 M7,15 L18,15 M7,20 L18,20 M7,25 L15,25" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Width="28" Height="36" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="FileNameLabel" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Details" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><TextBlock x:Name="Explanation" TextWrapping="Wrap"/></Border>
    </StackPanel>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Click="OnContinue" IsDefault="True" Margin="0,0,12,4"/><Button x:Name="CancelButton" IsCancel="True" Margin="0,0,0,4"/></WrapPanel>
  </Grid></Border>
</Window>
