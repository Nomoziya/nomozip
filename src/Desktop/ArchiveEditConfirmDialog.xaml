<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" x:Class="ArchivePassword.Desktop.ArchiveEditConfirmDialog" Style="{StaticResource AppWindow}" Width="600" Height="Auto" MinWidth="500" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" SizeToContent="Height">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
        <Viewbox Width="29" Height="34" Margin="0,0,16,0">
          <Grid Width="28" Height="34">
            <Path Data="M3,1 L18,1 L26,9 L26,33 L3,33 Z" Fill="{DynamicResource AccentBrush}"/>
            <Path Data="M18,1 L18,9 L26,9" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.5"/>
            <Path x:Name="ActionIcon" Data="M9,23 L18,14 L21,17 L12,26 L8,27 Z" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8"/>
          </Grid>
        </Viewbox>
        <TextBlock x:Name="Heading" VerticalAlignment="Center" Style="{StaticResource PageTitle}"/>
      </StackPanel>
      <StackPanel Grid.Row="1">
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource CanvasBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,18,0" Height="70">
            <Path Data="M2,1 L16,1 L23,8 L23,29 L2,29 Z M16,1 L16,8 L23,8 M7,15 L18,15 M7,20 L18,20 M7,25 L15,25" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Width="28" Height="36" Stretch="Uniform"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="FileNameLabel" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitle}"/>
            <StackPanel x:Name="ChangedState" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
              <Ellipse Fill="{DynamicResource SuccessBrush}" Width="10" Height="10" Margin="0,0,7,0"/>
              <TextBlock Text="{loc:Text TextEdit.Modified}" Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
            <TextBlock x:Name="Details" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <TextBlock x:Name="Explanation" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Click="OnContinue" IsDefault="True" Margin="0,0,12,4" MinWidth="140" MinHeight="40"/>
        <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,0,4" MinWidth="140" MinHeight="40"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
