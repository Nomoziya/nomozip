<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/nomozip.ico</ApplicationIcon>
    <AssemblyName>ArchivePassword</AssemblyName>
    <Version>0.2.1</Version>
    <FileVersion>0.2.1.0</FileVersion>
    <InformationalVersion>0.2.1</InformationalVersion>
    <Product>nomozip</Product>
    <Title>nomozip</Title>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Infrastructure/ArchivePassword.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/nomozip.ico" Link="Assets/nomozip.ico" /><Resource Include="../../assets/nomozip-256.png" Link="Assets/nomozip-256.png" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../../assets/fluent/Icons.xaml" Link="Icons/Fluent.xaml" />
    <Content Include="../../assets/fluent/LICENSE" Link="Licenses/Fluent-System-Icons.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
