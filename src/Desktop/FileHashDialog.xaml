<Window x:Class="ArchivePassword.Desktop.FileHashDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="文件 SHA-256" Width="820" Height="680" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="HashLayout" Margin="16" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="HashHeading" Margin="0,0,0,12"><TextBlock Text="文件 SHA-256" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="HashSubtitle" Text="计算文件指纹，或与期望值比较是否一致。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="HashAddButton" Content="添加文件" Command="{Binding AddFilesCommand}" Margin="0,0,12,0"/><Button x:Name="HashImportButton" Content="导入校验清单" Command="{Binding ImportCommand}" Margin="0,0,12,0"/><Button x:Name="HashRemoveButton" Content="移除所选" Command="{Binding RemoveCommand}"/></WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><Grid><DataGrid x:Name="HashTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" RowHeight="48" AutomationProperties.Name="SHA-256 文件列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}，{1}"><Binding Path="Name"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="170" ElementStyle="{StaticResource TableText}"/></DataGrid.Columns><DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}，{1}"><Binding Path="Name"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter></Style></DataGrid.CellStyle></DataGrid><TextBlock Text="添加文件或导入 UTF-8 的 SHA256SUMS 清单。" HorizontalAlignment="Center" VerticalAlignment="Center" ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <StackPanel x:Name="HashDetailsPanel" Grid.Row="3" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}">
      <TextBlock x:Name="HashSelectedPath" Text="{Binding Selected.Path}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Path}"/>
      <Label Content="计算值（SHA-256）" Target="{Binding ElementName=HashDigestBox}" Padding="0" Margin="0,8,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HashDigestBox" Text="{Binding Selected.Digest,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="所选文件的 SHA-256 计算值"/><Button Grid.Column="1" x:Name="HashCopyButton" Content="复制" Command="{Binding CopyCommand}" Margin="12,0,0,0" AutomationProperties.Name="复制所选 SHA-256 计算值"/></Grid>
      <Label Content="期望值（可选，64 位十六进制）" Target="{Binding ElementName=HashExpectedBox}" Padding="0" Margin="0,8,0,4"/><TextBox x:Name="HashExpectedBox" Text="{Binding Selected.ExpectedHash,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="所选文件的 SHA-256 期望值"/><TextBlock x:Name="HashExpectedError" Text="{Binding Selected.ExpectedError}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Style.Triggers><DataTrigger Binding="{Binding Selected.ExpectedError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
    <Expander x:Name="CompactHashDetails" Grid.Row="3" Header="校验值（所选文件）" Margin="0,8,0,0" Visibility="Collapsed"><ScrollViewer x:Name="CompactDetailsScroll" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></Expander>
    <StackPanel Grid.Row="4" Margin="0,8,0,0"><ProgressBar x:Name="HashProgress" Minimum="0" Maximum="100" Value="{Binding Progress,Mode=OneWay}" Height="6" AutomationProperties.Name="当前文件 SHA-256 计算进度"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Style.Triggers><DataTrigger Binding="{Binding ProgressText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="HashMessage" Text="{Binding Message}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/></StackPanel>
    <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="HashExportButton" Content="导出计算值清单" Command="{Binding ExportCommand}" Margin="0,0,12,0"/><Button x:Name="HashCalculateButton" Content="计算 / 校验" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button x:Name="HashCancelButton" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,12,0"/><Button x:Name="HashCloseButton" Content="关闭" Click="OnClose"/></WrapPanel>
  </Grid>
</Window>
