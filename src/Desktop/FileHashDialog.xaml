<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.FileHashDialog" Style="{StaticResource AppWindow}" Title="{loc:Text T_b3d70cc43d2a}" Width="1000" Height="700" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <DataTemplate x:Key="HashCalculationGlyph">
      <loc:FluentIcon Width="20" Height="20"><loc:FluentIcon.Style><Style TargetType="loc:FluentIcon"><Setter Property="Kind" Value="Clock"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasCalculated}" Value="True"><Setter Property="Kind" Value="CheckmarkCircle"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsCalculating}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding HasCalculationError}" Value="True"><Setter Property="Kind" Value="ErrorCircle"/><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></loc:FluentIcon.Style></loc:FluentIcon>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="HashLayout" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource SurfaceBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="HashDetailsColumn" Width="360"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="{DynamicResource ChromeBrush}">
      <StackPanel x:Name="HashHeading" Margin="24,36,24,20">
        <DockPanel>
          <Button x:Name="HashCloseButton" DockPanel.Dock="Right" Content="{loc:Text T_3fd47edce45b}" Click="OnClose" Style="{StaticResource SubtleButton}"/>
          <StackPanel Orientation="Horizontal">
            <loc:FluentIcon x:Name="HashPageIcon" Kind="Wrench" Width="34" Height="34" Foreground="{DynamicResource AccentBrush}" Margin="0,0,24,0"/>
            <TextBlock x:Name="HashPageTitle" Text="{loc:Text T_b3d70cc43d2a}" VerticalAlignment="Center" Style="{StaticResource PageTitle}"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="HashSubtitle" Text="{loc:Text T_282d839a46b1}" Style="{StaticResource Secondary}" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Padding="16,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1">
        <WrapPanel>
          <Button x:Name="HashAddButton" AutomationProperties.Name="{loc:Text T_ad9daebe00dc}" Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Padding="12,7">
            <StackPanel Orientation="Horizontal">
              <loc:FluentIcon Kind="Add" Width="20" Height="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
              <TextBlock Text="{loc:Text T_ad9daebe00dc}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="HashRemoveButton" Command="{Binding RemoveCommand}" Margin="0,0,8,4" Padding="12,7">
            <StackPanel Orientation="Horizontal">
              <loc:FluentIcon Kind="Delete" Width="20" Height="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
              <TextBlock Text="{loc:Text T_a194128b2939}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="HashImportButton" Content="{loc:Text Hash.ImportShort}" Command="{Binding ImportCommand}" Margin="0,0,8,4" ToolTip="{loc:Text T_6e2433d1240e}"/>
          <Button x:Name="HashExportButton" Content="{loc:Text Hash.ExportShort}" Command="{Binding ExportCommand}" Margin="0,0,8,4" ToolTip="{loc:Text T_e29c21446e54}"/>
        </WrapPanel>
      </Border>
      <Grid Grid.Row="1">
        <DataGrid x:Name="HashTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" RowHeight="40" AutomationProperties.Name="{loc:Text T_8b8256cab6ef}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                  <MultiBinding StringFormat="{loc:Text T_ee66a816c44e}">
                    <Binding Path="Name"/>
                    <Binding Path="Status"/>
                  </MultiBinding>
                </Setter.Value>
              </Setter>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{loc:Text T_d44e9b3d3b31}" Width="*" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <loc:FileKindIcon FileName="{Binding Path}" Width="20" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Text Hash.SizeLabel}" Binding="{Binding SizeText}" Width="70" ElementStyle="{StaticResource TableText}"/>
            <DataGridTextColumn Header="{loc:Text Hash.AlgorithmLabel}" Binding="{Binding Algorithm}" Width="80" ElementStyle="{StaticResource TableText}"/>
            <DataGridTemplateColumn Header="{loc:Text T_6320b4a8722a}" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HashCalculationGlyph}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding CalculationState}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{loc:Text Hash.ResultLabel}" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ComparisonResult}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ComparisonResult}" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMatch}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
              <Setter Property="ToolTip" Value="{Binding Path}"/>
              <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                  <MultiBinding StringFormat="{loc:Text T_ee66a816c44e}">
                    <Binding Path="Name"/>
                    <Binding Path="Status"/>
                  </MultiBinding>
                </Setter.Value>
              </Setter>
            </Style>
          </DataGrid.CellStyle>
        </DataGrid>
        <TextBlock Text="{loc:Text T_1a1507a7dc64}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <StackPanel x:Name="HashSummary" Grid.Row="2" Margin="20,12">
        <ProgressBar x:Name="HashProgress" Minimum="0" Maximum="100" Value="{Binding Progress,Mode=OneWay}" Height="6" AutomationProperties.Name="{loc:Text T_46482d9011f6}">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
        <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Style="{StaticResource Secondary}"/>
        <TextBlock x:Name="HashMessage" Text="{Binding Message}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
    <Border x:Name="HashDetailsSurface" Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,0" Padding="20">
      <ScrollViewer x:Name="HashDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HashDetailsPanel" IsEnabled="{Binding HasSelection}">
          <DockPanel Margin="0,0,0,20">
            <loc:FileKindIcon FileName="{Binding Selected.Path}" Width="32" Height="40" Margin="0,0,14,0" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Selected.Name}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" ToolTip="{Binding Selected.Path}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Secondary}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} | SHA-256">
                    <Binding Path="Selected.SizeText"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="HashSelectedPath" Text="{Binding Selected.Path}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Path}" Margin="0,0,0,16" Visibility="Collapsed"/>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,0,0,20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{loc:Text T_6320b4a8722a}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ContentControl Content="{Binding Selected}" ContentTemplate="{StaticResource HashCalculationGlyph}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Selected.CalculationState}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{loc:Text Hash.ResultLabel}" Margin="0,12,0,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ComparisonResult}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Selected.IsMatch}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Selected.IsMismatch}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <Label Content="{loc:Text T_2e9a859d8486}" Target="{Binding ElementName=HashDigestBox}" Padding="0" Margin="0,0,0,8"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Label.ContentTemplate></Label>
          <TextBox x:Name="HashDigestBox" Text="{Binding Selected.Digest,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="76" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" AutomationProperties.Name="{loc:Text T_cf5d453b4cbe}" Margin="0,0,0,20"/>
          <Label Content="{loc:Text T_80eae77ee4ed}" Target="{Binding ElementName=HashExpectedBox}" Padding="0" Margin="0,0,0,8"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Label.ContentTemplate></Label>
          <TextBox x:Name="HashExpectedBox" Text="{Binding Selected.ExpectedHash,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="76" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" AutomationProperties.Name="{loc:Text T_422af596a866}" loc:FieldState.HasError="{Binding Selected.HasExpectedError}"/>
          <TextBlock x:Name="HashExpectedError" Text="{Binding Selected.ExpectedError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Selected.ExpectedError}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <WrapPanel x:Name="HashActions" HorizontalAlignment="Left" Margin="0,24,0,0">
            <Button x:Name="HashCalculateButton" AutomationProperties.Name="{loc:Text T_446518e7ac65}" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <loc:FluentIcon Kind="Play" Width="20" Height="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Text T_446518e7ac65}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="HashCancelButton" Content="{loc:Text T_2cd0f3be8738}" Command="{Binding CancelCommand}" Margin="0,0,8,4"/>
            <Button x:Name="HashCopyButton" Command="{Binding CopyCommand}" Margin="0,0,0,4" AutomationProperties.Name="{loc:Text T_4d9ff0ad6b7c}" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <loc:FluentIcon Kind="Copy" Width="20" Height="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Text T_63d90d977348}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Expander x:Name="CompactHashDetails" Grid.Row="2" Grid.ColumnSpan="2" Header="{loc:Text T_d402a1d201a7}" Margin="16,8" Visibility="Collapsed">
      <ScrollViewer x:Name="CompactDetailsScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
    </Expander>
  </Grid>
</Window>
