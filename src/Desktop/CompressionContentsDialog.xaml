<Window x:Class="ArchivePassword.Desktop.CompressionContentsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop"
        Style="{StaticResource AppWindow}" Title="{loc:Text Compression.PreviewContents}" Width="860" Height="600" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Text Compression.PreviewContents}" Style="{StaticResource Heading}" Margin="0,0,48,10"/>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{loc:Text Compression.ContentPreviewHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <DataGrid x:Name="ContentTable" Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="36" ColumnHeaderHeight="32" AutomationProperties.Name="{loc:Text Compression.PreviewContents}">
      <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Text Compression.ContentState}" Binding="{Binding State}" Width="90" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="{loc:Text Compression.ContentPackage}" Binding="{Binding Package}" Width="140" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="{loc:Text Compression.ContentPath}" Binding="{Binding Path}" Width="*" MinWidth="160" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="{loc:Text T_301a69c74dfc}" Binding="{Binding SizeText}" Width="100" ElementStyle="{StaticResource TableText}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button x:Name="ClosePreviewButton" Grid.Row="3" Content="{loc:Text Compression.CloseContents}" Click="OnClose" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
