<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ArchiveContentsDialog" Style="{StaticResource AppWindow}" Title="{loc:Text T_fa5398fd7e94}" Width="1000" Height="680" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.InputBindings><KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}"/></Window.InputBindings>
  <Window.Resources><Style x:Key="ArchiveEditItem" TargetType="MenuItem" BasedOn="{StaticResource ActionMenuItem}"/></Window.Resources>
  <Grid x:Name="BrowserRoot" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="BrowserHeader" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,24,24,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Path Data="M3,1 L13,1 L20,8 L20,25 L3,25 Z M13,1 L13,8 L20,8 M7,14 L16,14 M12,10 L16,14 L12,18" Width="28" Height="34" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Margin="0,0,16,0"/>
          <TextBlock x:Name="ContentsArchiveName" Text="{Binding ArchiveName}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}" VerticalAlignment="Center" MaxWidth="460"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
          <TextBox x:Name="EntrySearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Padding="34,8,12,8" AutomationProperties.Name="{loc:Text T_88a399b911e0}"/>
          <Path Data="M8,1 A7,7 0 1 1 7.9,1 M13,13 L20,20" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False"/>
          <TextBlock Text="{loc:Text T_88a399b911e0}" Margin="36,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ArchivePath}" Style="{StaticResource Secondary}" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <WrapPanel x:Name="ContentsActions">
        <Button x:Name="ExtractAllButton" Command="{Binding ExtractAllCommand}" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><Path Data="M3,3 L8,3 M16,3 L21,3 L21,22 L3,22 L3,3 M12,1 L12,15 M7,10 L12,15 L17,10" Width="18" Height="20" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,10,0"/><TextBlock Text="{loc:Text Redesign.ExtractAll}" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="ExtractSelectedButton" Content="{loc:Text Redesign.ExtractSelected}" AutomationProperties.Name="{loc:Text Redesign.ExtractSelected}" Command="{Binding ExtractSelectedCommand}" Margin="0,0,8,4" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}"/>
        <Button x:Name="PreviewEntryButton" Command="{Binding PreviewCommand}" AutomationProperties.Name="{loc:Text Preview.Action}" ToolTip="{Binding PreviewHint}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><Path Data="M1,9 Q11,-4 21,9 Q11,22 1,9 M14,9 A3,3 0 1 1 8,9 A3,3 0 1 1 14,9" Width="20" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,10,0"/><TextBlock Text="{loc:Text Preview.CompactAction}" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="EditContentsButton" Content="{loc:Text Redesign.More}" Click="OnEditContents" IsEnabled="{Binding CanSelect}" Margin="0,0,8,4" AutomationProperties.Name="{loc:Text Drag.Actions}">
          <Button.ContextMenu><ContextMenu Style="{StaticResource ActionMenu}" x:Name="EditContentsMenu" Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text T_08f316ab8225}" Command="{Binding SelectVisibleCommand}"/><MenuItem Header="{loc:Text T_a3c974892464}" Command="{Binding ClearSelectionCommand}"/>
            <Separator Style="{StaticResource ActionMenuSeparator}"/>
            <MenuItem x:Name="PrepareDragAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text Drag.PrepareAction}" Command="{Binding PrepareDragCommand}"/>
            <MenuItem x:Name="AddEntryFilesAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_0475bef77baa}" Command="{Binding AddFilesCommand}"/>
            <MenuItem x:Name="AddEntryFolderAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_65c90110f894}" Command="{Binding AddFolderCommand}"/>
            <MenuItem x:Name="ReplaceEntryAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_7e41da13f3e7}" Command="{Binding ReplaceSelectedCommand}"/>
            <MenuItem x:Name="DeleteEntriesAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_5b76f8110c9e}" Command="{Binding DeleteSelectedCommand}"/>
            <Separator Style="{StaticResource ActionMenuSeparator}"/>
            <MenuItem Header="{loc:Text Redesign.CloseArchive}" Click="OnClose"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="CancelContentsButton" Content="{loc:Text T_a7084fcb218d}" Command="{Binding CancelCommand}" Margin="0,0,8,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
        <Button x:Name="OpenContentsResultButton" Content="{loc:Text T_a9a693eafd18}" Command="{Binding OpenResultCommand}" ToolTip="{Binding OutputPath}" Margin="0,0,8,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
      <DataGrid x:Name="EntryTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding CurrentRow}" SelectionMode="Single" IsEnabled="{Binding CanSelect}" RowHeight="42" AutomationProperties.Name="{loc:Text T_5db8427e5209}" ToolTip="{loc:Text Drag.Hint}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns>
        <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.Header><CheckBox IsChecked="{Binding VisibleSelection,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text T_08f316ab8225}" Margin="0"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{loc:Text T_77e1ea5c5688}" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M3,1 L12,1 L18,7 L18,22 L3,22 Z M12,1 L12,7 L18,7" Width="16" Height="20" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridRow}}" StrokeThickness="1.4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="{loc:Text T_ba40014ff496}" Binding="{Binding Kind}" Width="78" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="{loc:Text T_301a69c74dfc}" Binding="{Binding SizeText}" Width="80" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="{loc:Text T_320c254572c4}" Binding="{Binding EncryptionText}" Width="96" ElementStyle="{StaticResource TableText}"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Text="{loc:Text T_73d97e01d24e}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel><WrapPanel><TextBlock x:Name="ContentsSummary" Text="{Binding Summary}" Style="{StaticResource Secondary}" Margin="0,0,16,0"/><TextBlock x:Name="SelectionSummary" Text="{Binding SelectionSummary}" AutomationProperties.LiveSetting="Polite"/></WrapPanel>
        <TextBlock Text="{Binding OperationMessage}" Style="{StaticResource Secondary}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="ContentsOutputPath" Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OutputPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
    </Border>
    <Label x:Name="ContentsSearchLabel" Visibility="Collapsed"/><Button x:Name="SelectVisibleButton" Visibility="Collapsed" Command="{Binding SelectVisibleCommand}"/><Button x:Name="ClearSelectionButton" Visibility="Collapsed" Command="{Binding ClearSelectionCommand}"/>
  </Grid>
</Window>
