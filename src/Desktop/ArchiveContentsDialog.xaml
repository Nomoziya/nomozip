<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ArchiveContentsDialog" Style="{StaticResource AppWindow}" Title="{loc:Text T_fa5398fd7e94}" Width="1000" Height="680" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.InputBindings>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}"/>
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding FolderUpCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <Style x:Key="ArchiveEditItem" TargetType="MenuItem" BasedOn="{StaticResource ActionMenuItem}"/>
  </Window.Resources>
  <Grid x:Name="BrowserRoot" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="BrowserHeader" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,24,24,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Viewbox Width="22" Height="28" Margin="0,0,12,0">
            <Grid Width="28" Height="34">
              <Path Data="M3,1 L18,1 L26,9 L26,33 L3,33 Z" Fill="{DynamicResource AccentBrush}"/>
              <Path Data="M18,1 L18,9 L26,9 M8,22 L21,22 M16,16 L22,22 L16,28" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Grid>
          </Viewbox>
          <TextBlock x:Name="ContentsArchiveName" Text="{Binding ArchiveName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}" VerticalAlignment="Center" MaxWidth="460" Style="{StaticResource PageTitle}"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
          <TextBox x:Name="EntrySearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Padding="34,8,12,8" AutomationProperties.Name="{loc:Text T_88a399b911e0}" ToolTip="{loc:Text T_88a399b911e0}"/>
          <Path Data="M8,1 A7,7 0 1 1 7.9,1 M13,13 L20,20" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False"/>
          <TextBlock Text="{loc:Text Browser.SearchPlaceholder}" Margin="36,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,-6" Padding="0,10,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" ToolTip="{Binding ArchivePath}">
          <DockPanel LastChildFill="True">
            <Path DockPanel.Dock="Left" Data="M3,7 L3,4 L9,4 L12,7 L21,7 L21,21 L3,21 Z" Width="16" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding ArchiveLocation}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.2" Width="4" Height="8" Margin="14,0" VerticalAlignment="Center"/>
                    <Button Content="{Binding Label}" Command="{Binding NavigateCommand}" Style="{StaticResource SubtleButton}" Foreground="{DynamicResource TextBrush}" FontWeight="Normal" Padding="0,4" MaxWidth="240" ToolTip="{Binding Label}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <WrapPanel x:Name="ContentsActions">
        <Button x:Name="ExtractAllButton" Command="{Binding ExtractAllCommand}" Margin="0,0,8,4">
          <StackPanel Orientation="Horizontal">
            <Path Data="M3,3 L8,3 M16,3 L21,3 L21,22 L3,22 L3,3 M12,1 L12,15 M7,10 L12,15 L17,10" Width="18" Height="20" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,10,0"/>
            <TextBlock Text="{loc:Text Redesign.ExtractAll}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ExtractSelectedButton" AutomationProperties.Name="{loc:Text Redesign.ExtractSelected}" Command="{Binding ExtractSelectedCommand}" Margin="0,0,8,4" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}">
          <StackPanel Orientation="Horizontal">
            <Path Data="M3,1 L14,1 L21,8 L21,23 L3,23 Z M14,1 L14,8 L21,8 M12,9 L12,19 M8,15 L12,19 L16,15" Width="16" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Margin="0,0,10,0"/>
            <TextBlock Text="{loc:Text Redesign.ExtractSelected}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="PreviewEntryButton" Command="{Binding PreviewCommand}" AutomationProperties.Name="{loc:Text Preview.Action}" ToolTip="{Binding PreviewHint}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,4">
          <StackPanel Orientation="Horizontal">
            <Path Data="M1,9 Q11,-4 21,9 Q11,22 1,9 M14,9 A3,3 0 1 1 8,9 A3,3 0 1 1 14,9" Width="20" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,10,0"/>
            <TextBlock Text="{loc:Text Preview.CompactAction}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="EditContentsButton" Content="{loc:Text Redesign.More}" ContentTemplate="{StaticResource MoreActionContent}" Click="OnEditContents" IsEnabled="{Binding CanSelect}" Margin="0,0,8,4" AutomationProperties.Name="{loc:Text Drag.Actions}">
          <Button.ContextMenu>
            <ContextMenu Style="{StaticResource ActionMenu}" x:Name="EditContentsMenu" Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
              <ContextMenu.InputBindings>
                <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectVisibleCommand}"/>
              </ContextMenu.InputBindings>
              <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource ActionMenuItem}"/>
              </ContextMenu.ItemContainerStyle>
              <MenuItem Header="{loc:Text T_08f316ab8225}" Command="{Binding SelectVisibleCommand}" InputGestureText="Ctrl+A">
                <MenuItem.Icon>
                  <Path Data="M2,3 L5,3 M9,3 L24,3 M2,11 L5,11 M9,11 L24,11 M2,19 L5,19 M9,19 L24,19" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Text T_a3c974892464}" Command="{Binding ClearSelectionCommand}">
                <MenuItem.Icon>
                  <Path Data="M3,3 L21,21 M21,3 L3,21" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator Style="{StaticResource ActionMenuSeparator}"/>
              <MenuItem x:Name="PrepareDragAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text Drag.PrepareAction}" Command="{Binding PrepareDragCommand}">
                <MenuItem.Icon>
                  <Path Data="M3,8 L3,23 L23,23 L23,8 M13,17 L13,1 M7,7 L13,1 L19,7" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="AddEntryFilesAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_0475bef77baa}" Command="{Binding AddFilesCommand}">
                <MenuItem.Icon>
                  <Path Data="M3,1 L16,1 L23,8 L23,29 L3,29 Z M16,1 L16,8 L23,8 M8,18 L18,18 M13,13 L13,23" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="AddEntryFolderAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_65c90110f894}" Command="{Binding AddFolderCommand}">
                <MenuItem.Icon>
                  <Path Data="M1,6 L10,6 L13,10 L26,10 L26,27 L1,27 Z M8,19 L20,19 M14,13 L14,25" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="ReplaceEntryAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_7e41da13f3e7}" Command="{Binding ReplaceSelectedCommand}">
                <MenuItem.Icon>
                  <Path Data="M2,7 L20,7 L16,3 M20,7 L16,11 M22,20 L4,20 L8,16 M4,20 L8,24" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Text TextEdit.EditCopy}" Command="{Binding EditTextCommand}" ToolTip="{loc:Text TextEdit.Supported}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource ArchiveEditItem}">
                <MenuItem.Icon>
                  <Path Data="M3,1 L17,1 L24,8 L24,29 L3,29 Z M7,23 L9,17 L21,5 L25,9 L13,21 Z" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="DeleteEntriesAction" Style="{StaticResource ArchiveEditItem}" Header="{loc:Text T_5b76f8110c9e}" Command="{Binding DeleteSelectedCommand}">
                <MenuItem.Icon>
                  <Path Data="M2,6 L24,6 M8,6 L8,1 L18,1 L18,6 M5,6 L7,28 L19,28 L21,6 M10,11 L10,22 M16,11 L16,22" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator Style="{StaticResource ActionMenuSeparator}"/>
              <MenuItem Header="{loc:Text Redesign.CloseArchive}" Click="OnClose">
                <MenuItem.Icon>
                  <Path Data="M1,4 L10,4 L14,8 L26,8 L26,27 L1,27 Z M10,14 L19,23 M19,14 L10,23" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="20"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="CancelContentsButton" Content="{loc:Text T_a7084fcb218d}" Command="{Binding CancelCommand}" Margin="0,0,8,4">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="OpenContentsResultButton" Content="{loc:Text T_a9a693eafd18}" Command="{Binding OpenResultCommand}" ToolTip="{Binding OutputPath}" Margin="0,0,8,4">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
      <DataGrid x:Name="EntryTable" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding CurrentRow}" SelectionMode="Single" IsEnabled="{Binding CanSelect}" RowHeight="36" AutomationProperties.Name="{loc:Text T_5db8427e5209}" ToolTip="{loc:Text Drag.Hint}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnOpenEntry">
        <DataGrid.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding OpenCurrentEntryCommand}"/>
          <KeyBinding Key="Back" Command="{Binding FolderUpCommand}"/>
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="48">
            <DataGridTemplateColumn.Header>
              <CheckBox IsChecked="{Binding VisibleSelection,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text T_08f316ab8225}" Margin="0"/>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Text T_d44e9b3d3b31}" Width="*" MinWidth="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <loc:FileKindIcon FileName="{Binding Path}" IsDirectory="{Binding Entry.Directory}" Width="22" Height="26" VerticalAlignment="Center"/>
                  <Border Width="24" Height="24" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PreviewThumbnail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Image Source="{Binding PreviewThumbnail}" Stretch="UniformToFill"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{loc:Text Contents.CompactSize}" Binding="{Binding SizeText}" Width="110" ElementStyle="{StaticResource TableText}"/>
          <DataGridTextColumn Header="{loc:Text T_ba40014ff496}" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource TableText}"/>
          <DataGridTextColumn Header="{loc:Text T_320c254572c4}" Binding="{Binding EncryptionText}" Width="120" ElementStyle="{StaticResource TableText}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{loc:Text T_73d97e01d24e}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
    <Border x:Name="BrowserFooter" ToolTip="{Binding OutputPath}" Grid.Row="3" MinHeight="48" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <StackPanel>
        <DockPanel>
          <Button x:Name="BrowserTasksAction" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="OnShowTasks" Visibility="Collapsed" Padding="8,4" Margin="12,0,0,0" AutomationProperties.Name="{loc:Text Redesign.Tasks}" ToolTip="{loc:Text Redesign.Tasks}">
            <Path Data="M2,3 L4,3 M8,3 L20,3 M2,10 L4,10 M8,10 L20,10 M2,17 L4,17 M8,17 L20,17" Width="20" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
          </Button>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding OperationMessage}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="BrowserTaskActivity" AutomationProperties.LiveSetting="Polite" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
          <TextBlock x:Name="ContentsSummary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionSummary}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} · {1}"><Binding Path="CompactSummary"/><Binding Path="CompactSelectionSummary"/></MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DockPanel>
      </StackPanel>
    </Border>
    <Label x:Name="ContentsSearchLabel" Visibility="Collapsed"/>
    <Button x:Name="SelectVisibleButton" Visibility="Collapsed" Command="{Binding SelectVisibleCommand}"/>
    <Button x:Name="ClearSelectionButton" Visibility="Collapsed" Command="{Binding ClearSelectionCommand}"/>
  </Grid>
</Window>
