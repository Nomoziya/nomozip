        </DockPanel>
      </StackPanel>
    </Border>
    <Label x:Name="ContentsSearchLabel" Visibility="Collapsed"/>
    <Button x:Name="SelectVisibleButton" Visibility="Collapsed" Command="{Binding SelectVisibleCommand}"/>
    <Button x:Name="ClearSelectionButton" Visibility="Collapsed" Command="{Binding ClearSelectionCommand}"/>
  </Grid>
</Window>
