<Window x:Class="ArchivePassword.Desktop.ArchiveContentsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="压缩包内容" Width="900" Height="600" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="压缩包内容" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding ArchiveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}" Margin="0,4,0,0"/><TextBlock Text="只读浏览，不解压文件或保存密码。" ToolTip="加密文件在解压时仍需验证密码。" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Label Content="搜索包内路径" Target="{Binding ElementName=EntrySearch}" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="EntrySearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索包内文件或文件夹路径"/></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><Grid>
      <DataGrid x:Name="EntryTable" ItemsSource="{Binding Rows}" RowHeight="48" AutomationProperties.Name="压缩包内容列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns>
        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" MinWidth="150" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="72" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="原始大小" Binding="{Binding SizeText}" Width="100" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="加密" Binding="{Binding EncryptionText}" Width="80" ElementStyle="{StaticResource TableText}"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Text="没有匹配的文件或文件夹" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><Button Grid.Column="1" Content="关闭" IsCancel="True" Click="OnClose" Margin="16,0,0,0"/></Grid>
  </Grid>
</Window>
