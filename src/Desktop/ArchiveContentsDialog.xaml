      <ListBox x:Name="EntryTiles" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding CurrentRow,Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanSelect}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="8" MouseDoubleClick="OnOpenEntry" AutomationProperties.Name="{loc:Text Browser.GridView}">
