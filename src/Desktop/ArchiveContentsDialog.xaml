<Window x:Class="ArchivePassword.Desktop.ArchiveContentsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="压缩包内容" Width="900" Height="600" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8"><TextBlock Text="压缩包内容" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ContentsArchiveName" Text="{Binding ArchiveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}" Margin="0,4,0,0"/><TextBlock Visibility="Collapsed" Text="浏览仅列出内容；勾选后可解压所选范围。" ToolTip="加密文件在解压时仍需验证密码。" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="搜索包内路径" Target="{Binding ElementName=EntrySearch}" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="EntrySearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索包内文件或文件夹路径"/><WrapPanel Grid.Column="2"><Button x:Name="SelectVisibleButton" Content="选择可见项" Command="{Binding SelectVisibleCommand}" Margin="8,0,8,0"/><Button x:Name="ClearSelectionButton" Content="清空选择" Command="{Binding ClearSelectionCommand}"/></WrapPanel></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><Grid>
      <DataGrid x:Name="EntryTable" ItemsSource="{Binding Rows}" IsEnabled="{Binding CanSelect}" RowHeight="48" AutomationProperties.Name="压缩包内容列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns>
        <DataGridTemplateColumn Header="选择" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" MinWidth="150" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="72" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="原始大小" Binding="{Binding SizeText}" Width="100" ElementStyle="{StaticResource TableText}"/>
        <DataGridTextColumn Header="加密" Binding="{Binding EncryptionText}" Width="80" ElementStyle="{StaticResource TableText}"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Text="没有匹配的文件或文件夹" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid></Border>
    <StackPanel Grid.Row="3" Margin="0,4,0,0"><TextBlock x:Name="ContentsSummary" Text="{Binding Summary}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/><TextBlock x:Name="SelectionSummary" Text="{Binding SelectionSummary}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OperationMessage}" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OutputPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="ExtractSelectedButton" Content="解压所选" Command="{Binding ExtractSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="取消操作" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="打开结果目录" Command="{Binding OpenResultCommand}" Margin="0,0,8,0"/><Button Content="关闭" IsCancel="True" Click="OnClose" Margin="0,0,0,0"/></WrapPanel>
  </Grid>
</Window>
