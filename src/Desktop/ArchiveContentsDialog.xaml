      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"><ToggleButton x:Name="ListViewAction" Tag="list" Click="OnViewMode" Style="{StaticResource ViewToggle}" AutomationProperties.Name="{loc:Text Browser.ListView}" ToolTip="{loc:Text Browser.ListView}" Margin="0,0,4,0" IsChecked="{Binding ListView,Mode=TwoWay}"><loc:FluentIcon Kind="TaskListSquareLtr" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20"/></ToggleButton><ToggleButton x:Name="GridViewAction" Tag="grid" Click="OnViewMode" Style="{StaticResource ViewToggle}" AutomationProperties.Name="{loc:Text Browser.GridView}" ToolTip="{loc:Text Browser.GridView}" IsChecked="{Binding GridView,Mode=TwoWay}"><loc:FluentIcon Kind="Grid" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20"/></ToggleButton></StackPanel>
          <Button x:Name="BrowserTasksAction" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="OnShowTasks" Visibility="Collapsed" Padding="4" Margin="12,0,0,0" AutomationProperties.Name="{loc:Text Redesign.Tasks}"><TextBlock x:Name="BrowserTaskActivity" TextTrimming="CharacterEllipsis" MaxWidth="150" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/></Button>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ViewStatus}" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center" ToolTip="{Binding ViewStatus}" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="ContentsSummary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompactSelectionSummary}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} · {1}"><Binding Path="CompactSummary"/><Binding Path="CompactSelectionSummary"/></MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DockPanel>
      </StackPanel>
    </Border>
    <Label x:Name="ContentsSearchLabel" Visibility="Collapsed"/>
    <Button x:Name="SelectVisibleButton" Visibility="Collapsed" Command="{Binding SelectVisibleCommand}"/>
    <Button x:Name="ClearSelectionButton" Visibility="Collapsed" Command="{Binding ClearSelectionCommand}"/>
  </Grid>
</Window>
