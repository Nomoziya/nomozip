<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" x:Class="ArchivePassword.Desktop.VaultDetailsView">
  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceBrush}" Padding="24,16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" IsEnabled="{Binding IsIdle}">
          <TextBlock x:Name="Heading" Text="{loc:Text Redesign.VaultDetails}" Margin="0,0,0,12" Style="{StaticResource SectionTitle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="{loc:Text T_d44e9b3d3b31}" Target="{Binding ElementName=NameBox}" Grid.Row="0" Margin="0,0,8,10" VerticalAlignment="Center" Padding="0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <TextBox x:Name="NameBox" Height="36" Margin="0,0,0,10" Grid.Row="0" Grid.Column="1"/>
            <Label Content="{loc:Text T_a621ab606db2}" Target="{Binding ElementName=SecretBox}" Grid.Row="1" Margin="0,0,8,10" VerticalAlignment="Center" Padding="0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
              <PasswordBox x:Name="SecretBox" Padding="10,6,36,6" Height="36"/>
              <TextBox x:Name="VisibleSecret" Visibility="Collapsed" Padding="10,6,36,6" Height="36"/>
            </Grid>
            <Label Content="{loc:Text T_399ee6934772}" Target="{Binding ElementName=GroupBox}" Grid.Row="3" Margin="0,0,8,10" VerticalAlignment="Center" Padding="0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <ComboBox x:Name="GroupBox" IsEditable="True" IsTextSearchEnabled="False" MaxHeight="36" Margin="0,0,0,10" Grid.Row="3" Grid.Column="1"/>
            <Label Content="{loc:Text T_daede9881787}" Target="{Binding ElementName=NotesBox}" Grid.Row="4" Margin="0,0,8,10" VerticalAlignment="Center" Padding="0">
              <Label.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </Label.ContentTemplate>
            </Label>
            <TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="80" MinHeight="80" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" VerticalContentAlignment="Top"/>
            <CheckBox x:Name="ShowSecret" Checked="OnVisibilityChanged" Unchecked="OnVisibilityChanged" Grid.Row="1" Grid.Column="1" Margin="0,0,4,12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" ToolTip="{loc:Text T_ffe21a671190}" AutomationProperties.Name="{loc:Text T_ffe21a671190}">
              <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                  <Grid Background="Transparent">
                    <Path Data="M1,10 Q12,-3 23,10 Q12,23 1,10 M16,10 A4,4 0 1 1 8,10 A4,4 0 1 1 16,10" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Width="22" Height="18" Stretch="Uniform"/>
                    <Path x:Name="Slash" Data="M3,2 L21,20" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Visibility="Collapsed" Width="22" Height="20" Stretch="Uniform"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </CheckBox.Template>
            </CheckBox>
            <CheckBox x:Name="AutoTryBox" Content="{loc:Text T_a3610c2b94b0}" Grid.Row="5" Grid.Column="1" Margin="0,4,0,4"/>
          </Grid>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0">
            <Expander x:Name="RulesExpander" Header="{loc:Text T_abab7359518e}" Margin="0,10,0,8">
              <StackPanel>
                <Label Content="{loc:Text T_b5bb08da76d9}" Target="{Binding ElementName=SourceBox}">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <TextBox x:Name="SourceBox" MaxLength="512"/>
                <Label Content="{loc:Text T_724d7a12cc56}" Target="{Binding ElementName=MatchBox}">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <TextBox x:Name="MatchBox" MaxLength="256"/>
              </StackPanel>
            </Expander>
          </Border>
          <TextBlock x:Name="Error" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0"><Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SaveButton" MinHeight="40" Content="{loc:Text Redesign.SaveChanges}" Click="OnSave" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Grid.Column="0" HorizontalAlignment="Stretch"/>
        <Button MinHeight="40" Content="{loc:Text T_2cd0f3be8738}" Click="OnCancel" Margin="0,0,8,0" Grid.Column="1" HorizontalAlignment="Stretch"/>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0"><Button Content="{loc:Text T_176f8887e229}" Command="{Binding DeletePasswordCommand}" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Foreground="{DynamicResource ErrorBrush}" MinHeight="28" Padding="0,4"/></Border>
      </Grid></Border>
    </Grid>
  </Border>
</UserControl>
