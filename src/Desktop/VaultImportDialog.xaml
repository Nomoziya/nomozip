<Window x:Class="ArchivePassword.Desktop.VaultImportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="预览密码导入" Width="700" Height="540" MinWidth="380" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="330"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="预览密码导入" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="只显示名称和备注，不显示密码。现有记录、自动尝试设置及压缩包关联保持不变。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,16"><Label Content="重复密码处理" Target="{Binding ElementName=ModeBox}" Padding="0"/><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged" AutomationProperties.Name="重复密码处理" Margin="0,8,0,8"><ComboBoxItem Content="跳过重复密码，保留本机记录（推荐）"/><ComboBoxItem Content="保留两份，重复项也添加为新记录"/></ComboBox><TextBlock x:Name="SummaryLabel" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <DataGrid Grid.Row="2" x:Name="PreviewTable" RowHeight="48" AutomationProperties.Name="备份密码导入预览" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}，{1}"><Binding Path="Name"/><Binding Path="Action"/></MultiBinding></Setter.Value></Setter></Style></DataGrid.RowStyle>
      <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="90" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*" MinWidth="70" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="处理方式" Binding="{Binding Action}" Width="112" ElementStyle="{StaticResource TableText}"/></DataGrid.Columns>
    </DataGrid>
    </Grid></ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,12,0"/><Button x:Name="ImportButton" Content="确认导入" IsDefault="True" Click="OnImport" Style="{StaticResource PrimaryButton}"/></WrapPanel>
  </Grid>
</Window>
