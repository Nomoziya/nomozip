<Window x:Class="ArchivePassword.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="压缩包工具" Width="1120" Height="760" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
  <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}"/><KeyBinding Key="E" Modifiers="Control" Command="{Binding ExtractCommand}"/></Window.InputBindings>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="压缩包工具" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="解压与密码管理" Style="{StaticResource Secondary}" Margin="0,6,0,0"/></StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="密码仅保存在本机" Style="{StaticResource Secondary}" Margin="8,12,0,0"/>
        <ListBox SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="主要导航" VerticalAlignment="Top">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusStyle}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBoxItem Content="解压"/><ListBoxItem Content="密码库"/><ListBoxItem Content="设置"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SelectionBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Banner}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <Grid Grid.Row="1">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="解压" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="添加压缩包，选择输出目录后开始。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><DockPanel><Button Content="添加压缩包" Command="{Binding AddFilesCommand}" DockPanel.Dock="Left" AutomationProperties.Name="添加压缩包，Control O"/><Button Content="移除所选" Command="{Binding RemoveFileCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="也可以将文件拖入此窗口" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0"/></DockPanel></Border>
        <ScrollViewer Grid.Row="2" x:Name="ExtractionViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Grid x:Name="ExtractionLayout">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="SettingsColumn" Width="280"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="SettingsRow" Height="0"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="压缩包" Style="{StaticResource Heading}"/>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="压缩包任务列表">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="文件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding SizeText}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="状态" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><ProgressBar Value="{Binding Percent}" Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding ProgressVisibility}" AutomationProperties.Name="解压进度"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="2" Text="{Binding TaskSummary}" Style="{StaticResource Secondary}" Margin="8,16,0,0"/>
              <TextBlock Grid.Row="1" Text="添加压缩包或拖入文件" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </Border>
          <Border x:Name="SettingsPanel" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="解压设置" Style="{StaticResource Heading}"/>
              <Label Content="输出目录" Target="{Binding ElementName=OutputBox}" Padding="0"/><TextBox x:Name="OutputBox" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" AutomationProperties.Name="输出目录" IsEnabled="{Binding IsIdle}"/><Button Content="浏览目录" Command="{Binding BrowseOutputCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
              <Label Content="同名文件" Target="{Binding ElementName=ConflictBox}" Padding="0"/><ComboBox x:Name="ConflictBox" SelectedIndex="{Binding ConflictPolicy}" Margin="0,8,0,16" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="同名文件处理"><ComboBoxItem Content="每次询问"/><ComboBoxItem Content="跳过同名文件"/><ComboBoxItem Content="覆盖同名文件"/></ComboBox>
              <CheckBox Content="自动尝试保存的密码" IsChecked="{Binding AutoTry}" IsEnabled="{Binding IsIdle}"/><TextBlock Text="{Binding VaultSummary}" Style="{StaticResource Secondary}"/><Button Content="管理密码库" Command="{Binding OpenVaultCommand}" Margin="0,12,0,20"/>
              <Button Content="{Binding ExtractButtonText}" Command="{Binding ExtractCommand}" MinHeight="44" AutomationProperties.Name="开始解压，Control E"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsNarrow}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="跳过尝试，输入密码" Command="{Binding SkipPasswordsCommand}" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanSkipPasswords}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="取消当前任务" Command="{Binding CancelCommand}" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}" Margin="0,16,0,0"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="密码库" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="保存常用密码，下次解压时自动尝试。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button Content="添加密码" Command="{Binding AddPasswordCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/><Label Content="搜索名称或备注" Target="{Binding ElementName=PasswordSearch}" DockPanel.Dock="Left" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0"/><TextBox x:Name="PasswordSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索密码名称或备注" ToolTip="搜索名称或备注，不搜索密码明文"/></DockPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding PasswordRows}" SelectedItem="{Binding SelectedPassword}" AutomationProperties.Name="已保存密码列表"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*"/><DataGridCheckBoxColumn Header="自动尝试" Binding="{Binding AutoTry}" Width="90"/><DataGridTextColumn Header="最近使用" Binding="{Binding LastSuccessAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="编辑所选密码" Command="{Binding EditPasswordCommand}"/><Button Content="删除所选密码" Command="{Binding DeletePasswordCommand}" Margin="12,0,0,0"/></StackPanel></Grid></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="引擎与更新" Style="{StaticResource Heading}"/><TextBlock Text="产品版本：0.1.0 开发预览" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding EngineSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviousEngineSummary}" Style="{StaticResource Secondary}" Margin="0,8,0,16"/>
            <Label Content="可用引擎" Target="{Binding ElementName=EngineChoice}" Padding="0"/><ComboBox x:Name="EngineChoice" ItemsSource="{Binding EngineVersions}" SelectedItem="{Binding SelectedEngineVersion}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="选择已验证的本地引擎" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,12,0,16"><Button Content="使用所选版本" Command="{Binding ApplyEngineCommand}" Margin="0,0,12,8"/><Button Content="恢复上一版本" Command="{Binding RollbackEngineCommand}" Margin="0,0,0,8"/></WrapPanel>
            <Label Content="GitHub 更新仓库" Target="{Binding ElementName=UpdateRepositoryBox}" Padding="0"/><TextBox x:Name="UpdateRepositoryBox" Text="{Binding UpdateRepository, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="GitHub 更新仓库地址" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding UpdateChannelDescription}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,16,0,0"><Button Content="检查更新" Command="{Binding CheckUpdatesCommand}" Margin="0,0,12,8"/><Button Content="下载并更新引擎" Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button Content="导入更新包" Command="{Binding ImportUpdateCommand}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="取消更新" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="密码存储" Style="{StaticResource Heading}"/><TextBlock Text="密码由当前 Windows 用户加密保护。换电脑或重装系统时，不能直接迁移此密码库。" Style="{StaticResource Secondary}"/><Button Content="恢复密码库备份" Command="{Binding RestoreVaultCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关于" Style="{StaticResource Heading}"/><TextBlock Text="使用官方 7-Zip 引擎。许可证与来源信息随产品附带。" Style="{StaticResource Secondary}"/><Button Content="查看许可证与来源" Command="{Binding OpenLicensesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,16,0,0">
        <Button Content="{Binding ExtractButtonText}" Command="{Binding ExtractCommand}" MinHeight="44" DockPanel.Dock="Right" Margin="16,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Page}" Value="0"/><Condition Binding="{Binding IsNarrow}" Value="True"/><Condition Binding="{Binding IsIdle}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="取消当前任务" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Margin="16,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsNarrow}" Value="True"/><Condition Binding="{Binding IsBusy}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
        <TextBlock Text="{Binding Footer}" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
