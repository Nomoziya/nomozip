<Window x:Class="ArchivePassword.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArchivePassword.Desktop" Style="{StaticResource AppWindow}" Title="nomozip" Width="1120" Height="760" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
  <Window.Resources><local:PasswordMetadataConverter x:Key="PasswordMetadata"/></Window.Resources>
  <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenInputCommand}"/><KeyBinding Key="L" Modifiers="Control" Command="{Binding BrowseArchiveCommand}"/><KeyBinding Key="E" Modifiers="Control" Command="{Binding ExtractCommand}"/><KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CreateArchiveCommand}"/></Window.InputBindings>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel x:Name="SidebarContent" Margin="16,24">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="nomozip" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="解压与密码管理" Style="{StaticResource Secondary}" Margin="0,6,0,0"/></StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="密码仅保存在本机" Style="{StaticResource Secondary}" Margin="8,12,0,0"/>
        <ListBox x:Name="Navigation" Foreground="{DynamicResource TextBrush}" SelectedIndex="{Binding NavigationIndex}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="主要导航" VerticalAlignment="Top">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusStyle}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBoxItem Content="解压"/><ListBoxItem Content="压缩"/><ListBoxItem Content="密码库"/><ListBoxItem Content="设置"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid x:Name="MainContent" Grid.Column="1" Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SelectionBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Banner}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Foreground="{DynamicResource SelectionTextBrush}" Text="{Binding Banner}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <Grid Grid.Row="1">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="解压" FontSize="24" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Text" Value="{Binding ExtractionSubtitle}"/><Style.Triggers><DataTrigger Binding="{Binding HasShellDestinations}" Value="True"><Setter Property="Text" Value="{Binding ShellDestinationDescription}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><WrapPanel><Button Content="添加压缩包" Command="{Binding AddFilesCommand}" AutomationProperties.Name="添加压缩包，Control O"/><Button x:Name="BrowseArchiveAction" Content="查看内容" Command="{Binding BrowseArchiveCommand}" AutomationProperties.Name="查看所选压缩包内容，Control L" Margin="12,0,0,0"/><Button x:Name="TestArchiveAction" Content="校验压缩包" Command="{Binding TestArchiveCommand}" AutomationProperties.Name="校验所选压缩包，不解压文件" Margin="12,0,0,0"/><Button Content="移除所选" Command="{Binding RemoveFileCommand}" Margin="12,0,0,0"/><TextBlock x:Name="ExtractionDropHint" Text="也可以将文件拖入此窗口" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0"/></WrapPanel></Border>
        <ScrollViewer Grid.Row="2" x:Name="ExtractionViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Grid x:Name="ExtractionLayout">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="SettingsColumn" Width="280"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="SettingsRow" Height="0"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="压缩包" Style="{StaticResource Heading}"/>
              <DataGrid x:Name="ArchiveTasks" Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="压缩包任务列表">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding ShellOutputPath}"/><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}，{1}，{2}"><Binding Path="Name"/><Binding Path="SizeText"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter></Style></DataGrid.RowStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}，{1}，{2}"><Binding Path="Name"/><Binding Path="Column.Header" RelativeSource="{RelativeSource Self}"/><Binding Path="Status"/></MultiBinding></Setter.Value></Setter></Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="文件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding SizeText}" Style="{StaticResource GridSecondary}" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="状态" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><ProgressBar Value="{Binding Percent}" Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding ProgressVisibility}" AutomationProperties.Name="解压进度"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <DockPanel Grid.Row="2" Margin="8,16,0,0"><Button x:Name="TestResultAction" Content="校验结果" Command="{Binding ShowTestResultCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="FailureDetailsAction" Content="失败详情" Command="{Binding ShowFailureCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="查看所选任务失败条目"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding TaskSummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
              <TextBlock Grid.Row="1" Text="添加压缩包或拖入文件" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </Border>
          <Border x:Name="SettingsPanel" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="解压设置" Style="{StaticResource Heading}"/>
              <Label Content="输出目录" Target="{Binding ElementName=OutputBox}" Padding="0"/><TextBox x:Name="OutputBox" Text="{Binding DisplayOutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" AutomationProperties.Name="输出目录" IsEnabled="{Binding IsIdle}" IsReadOnly="{Binding IsOutputPathReadOnly}"/><WrapPanel Margin="0,0,0,16"><Button Content="浏览目录" Command="{Binding BrowseOutputCommand}" Margin="0,0,12,0"/><Button x:Name="ExtractionRulesAction" Content="解压规则…" Command="{Binding EditExtractionRulesCommand}"/></WrapPanel>
              <Label Content="同名文件" Target="{Binding ElementName=ConflictBox}" Padding="0"/><ComboBox x:Name="ConflictBox" SelectedIndex="{Binding ConflictPolicy}" Margin="0,8,0,16" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="同名文件处理"><ComboBoxItem Content="每次询问"/><ComboBoxItem Content="跳过同名文件"/><ComboBoxItem Content="覆盖同名文件"/></ComboBox>
              <CheckBox Content="自动尝试保存的密码" IsChecked="{Binding AutoTry}" IsEnabled="{Binding IsIdle}"/><TextBlock Text="{Binding VaultSummary}" Style="{StaticResource Secondary}"/><Button Content="管理密码库" Command="{Binding OpenVaultCommand}" Margin="0,12,0,20"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="密码库" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="保存常用密码，下次解压时自动尝试。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="152"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="搜索名称、备注或来源" Target="{Binding ElementName=PasswordSearch}" Padding="0" Margin="0,0,0,8"/><TextBox Grid.Row="1" x:Name="PasswordSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索密码名称或备注" ToolTip="搜索名称、备注、分组、来源和规则，不搜索密码明文"/></Grid><StackPanel Grid.Column="1" Margin="12,0,0,0"><Label Content="分组" Target="{Binding ElementName=PasswordGroupBox}" Padding="0" Margin="0,0,0,8"/><ComboBox x:Name="PasswordGroupBox" ItemsSource="{Binding PasswordGroups}" SelectedItem="{Binding SelectedPasswordGroup}" DisplayMemberPath="Label" AutomationProperties.Name="筛选密码分组"/></StackPanel><Button Grid.Column="2" Content="添加密码" Command="{Binding AddPasswordCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="12,0,0,0"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid>
          <DataGrid x:Name="PasswordTable" ItemsSource="{Binding PasswordRows}" SelectedItem="{Binding SelectedPassword}" RowHeight="48" AutomationProperties.Name="已保存密码列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="名称与来源" Width="*" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="12,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Converter={StaticResource PasswordMetadata}}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Converter={StaticResource PasswordMetadata}}" Foreground="{DynamicResource SecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Converter={StaticResource PasswordMetadata}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*" MinWidth="80" ElementStyle="{StaticResource TableText}"/>
              <DataGridTemplateColumn Header="自动尝试" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TableText}"><Setter Property="Text" Value="已停用"/><Style.Triggers><DataTrigger Binding="{Binding AutoTry}" Value="True"><Setter Property="Text" Value="已启用"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="最近使用" Binding="{Binding LastSuccessAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=尚未使用}" Width="148" ElementStyle="{StaticResource TableText}"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="没有匹配的密码。可调整搜索或添加密码。" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" Margin="16"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PasswordRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

      </Grid></Border>
        <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding PasswordListSummary}" Style="{StaticResource Secondary}"/><TextBlock x:Name="DuplicateSummaryText" Text="{Binding DuplicateSummary}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="软件更新" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="ApplicationVersionText" Text="{Binding ApplicationVersionDescription}" Margin="0,0,0,8"/>
            <TextBlock Text="软件正式版由 nomozip 发布，与 7-Zip 引擎更新分别检查。" Style="{StaticResource Secondary}"/>
            <WrapPanel Margin="0,16,0,0"><Button x:Name="CheckApplicationUpdatesButton" Content="检查软件更新" Command="{Binding CheckApplicationUpdatesCommand}" Margin="0,0,12,8"/><Button x:Name="OpenApplicationDownloadButton" Content="打开软件下载页" Command="{Binding OpenApplicationDownloadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock x:Name="ApplicationUpdateStatus" Text="{Binding ApplicationUpdateMessage}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="取消软件检查" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCheckingApplicationUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="解压引擎" Style="{StaticResource Heading}"/>
            <TextBlock Text="{Binding EngineSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviousEngineSummary}" Style="{StaticResource Secondary}" Margin="0,8,0,16"/>
            <Label Content="可用引擎" Target="{Binding ElementName=EngineChoice}" Padding="0"/><ComboBox x:Name="EngineChoice" ItemsSource="{Binding EngineVersions}" SelectedItem="{Binding SelectedEngineVersion}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="选择已验证的本地引擎" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,12,0,16"><Button Content="使用所选版本" Command="{Binding ApplyEngineCommand}" Margin="0,0,12,8"/><Button Content="恢复上一版本" Command="{Binding RollbackEngineCommand}" Margin="0,0,0,8"/></WrapPanel>
            <Label Content="GitHub 更新仓库" Target="{Binding ElementName=UpdateRepositoryBox}" Padding="0"/><TextBox x:Name="UpdateRepositoryBox" Text="{Binding UpdateRepository, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="GitHub 更新仓库地址" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding UpdateChannelDescription}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,16,0,0"><Button Content="检查引擎更新" Command="{Binding CheckUpdatesCommand}" Margin="0,0,12,8"/><Button Content="下载并更新引擎" Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button Content="导入更新包" Command="{Binding ImportUpdateCommand}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="取消引擎更新" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="True"/><Condition Binding="{Binding IsCheckingApplicationUpdate}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="密码存储" Style="{StaticResource Heading}"/><TextBlock Text="本机密码由当前 Windows 用户加密保护。换电脑、换账号或重装前，请在密码库中导出加密备份；导入时需要备份密码。恢复备份用于撤销本机最近一次保存。" Style="{StaticResource Secondary}"/><Button Content="恢复密码库备份" Command="{Binding RestoreVaultCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Windows 文件入口" Style="{StaticResource Heading}"/><TextBlock Text="添加后可从“打开方式”启动 nomozip，不会直接更改默认应用。Windows 首次打开可能询问使用哪个应用，默认程序由你在系统窗口选择。" Style="{StaticResource Secondary}"/><WrapPanel Margin="0,16,0,0"><Button Content="添加打开方式入口" Command="{Binding RegisterAssociationsCommand}" Margin="0,0,12,8"/><Button Content="移除本程序入口" Command="{Binding RemoveAssociationsCommand}" Margin="0,0,0,8"/><Button Content="Windows 默认应用设置" Command="{Binding OpenDefaultAppsCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding AssociationMessage}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="右键菜单" Style="{StaticResource Heading}"/><TextBlock Text="在文件和文件夹的右键菜单中添加 nomozip：压缩包可直接解压，文件或文件夹可进入压缩页。Windows 11 当前在“显示更多选项”中使用。此入口与打开方式分别管理，不更改默认应用。" Style="{StaticResource Secondary}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="RegisterShellMenuButton" Content="添加右键菜单" Command="{Binding RegisterShellMenuCommand}" Margin="0,0,12,8"/><Button x:Name="RemoveShellMenuButton" Content="移除右键菜单" Command="{Binding RemoveShellMenuCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding ShellMenuMessage}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="文件校验" Style="{StaticResource Heading}"/><TextBlock Text="计算文件 SHA-256、比较期望值，或导入和导出校验清单。" Style="{StaticResource Secondary}"/><Button x:Name="OpenFileHashesButton" Content="文件 SHA-256" Command="{Binding FileHashCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关于" Style="{StaticResource Heading}"/><TextBlock Text="使用官方 7-Zip 引擎。许可证与来源信息随产品附带。" Style="{StaticResource Secondary}"/><Button Content="查看许可证与来源" Command="{Binding OpenLicensesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <local:CompressionView x:Name="CompressionPage" xmlns:local="clr-namespace:ArchivePassword.Desktop" Grid.Row="1" Grid.RowSpan="2">
        <local:CompressionView.Style><Style TargetType="local:CompressionView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:CompressionView.Style>
      </local:CompressionView>
      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel HorizontalAlignment="Right">
          <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
          <Button x:Name="ExtractAction" Content="{Binding ExtractButtonText}" Command="{Binding ExtractCommand}" MinHeight="44" AutomationProperties.Name="开始解压，Control E" Margin="0,0,12,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsIdle}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="取消当前任务" Command="{Binding CancelCommand}" Margin="0,0,12,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="跳过尝试，输入密码" Command="{Binding SkipPasswordsCommand}" Margin="0,0,12,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanSkipPasswords}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}" Margin="0,0,0,8"/>
        </WrapPanel>
        <WrapPanel HorizontalAlignment="Right"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="取消备份操作" Command="{Binding CancelCommand}" Margin="0,0,12,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="ImportVaultButton" Content="导入备份" Command="{Binding ImportVaultCommand}" Margin="0,0,12,8"/><Button x:Name="ExportVaultButton" Content="导出备份" Command="{Binding ExportVaultCommand}" Margin="0,0,12,8"/><Button x:Name="MergePasswordsButton" Content="合并重复" Command="{Binding MergePasswordsCommand}" Margin="0,0,12,8"/><Button Content="编辑所选密码" Command="{Binding EditPasswordCommand}" Margin="0,0,12,8"/><Button Content="删除所选密码" Command="{Binding DeletePasswordCommand}" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding Footer}" Style="{StaticResource Secondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
