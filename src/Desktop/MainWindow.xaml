              <Path Data="M2,6 L10,6 L13,9 L25,9 L25,25 L2,25 Z" Width="20" Height="22" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,10,0"/>
              <TextBlock Text="{loc:Text Redesign.OpenArchive}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Click="OnCompression" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}">
