                <TextBlock Text="{loc:Text T_52d25a9e30ba}" Style="{StaticResource Heading}"/>
                <TextBlock Text="{loc:Text T_f8753cf655b4}" Style="{StaticResource Secondary}"/>
                <Button Content="{loc:Text T_362754cb43df}" Command="{Binding OpenLicensesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <local:CompressionView xmlns:local="clr-namespace:ArchivePassword.Desktop" x:Name="CompressionPage" Grid.Row="1" Grid.RowSpan="2" Margin="0">
        <local:CompressionView.Style>
          <Style TargetType="local:CompressionView">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Page}" Value="3">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Visibility" Value="Collapsed"/>
          </Style>
        </local:CompressionView.Style>
      </local:CompressionView>
      <Grid Grid.Row="2">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Page}" Value="3">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Page}" Value="0">
                <Setter Property="Margin" Value="0"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel HorizontalAlignment="Right">
          <WrapPanel.Style>
            <Style TargetType="WrapPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="1">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
              <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
          </WrapPanel.Style>
          <Button Content="{loc:Text T_b5e264b0d6f8}" Command="{Binding CancelCommand}" Margin="0,0,12,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
                <Setter Property="Visibility" Value="Collapsed"/>
              </Style>
            </Button.Style>
          </Button>
          <Button x:Name="ImportVaultButton" Content="{loc:Text T_ec217804074a}" Command="{Binding ImportVaultCommand}" Margin="0,0,12,8" Visibility="Collapsed"/>
          <Button x:Name="ExportVaultButton" Content="{loc:Text T_e9d3dd690a4e}" Command="{Binding ExportVaultCommand}" Margin="0,0,12,8" Visibility="Collapsed"/>
          <Button x:Name="MergePasswordsButton" Content="{loc:Text T_fcdc3edb34ff}" Command="{Binding MergePasswordsCommand}" Margin="0,0,12,8" Visibility="Collapsed"/>
        </WrapPanel>
        <TextBlock Grid.Row="2" Text="{Binding Footer}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
              <Setter Property="Margin" Value="20,10"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="1">
                  <Setter Property="Margin" Value="20,4,20,10"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Row="1" Margin="20,10,20,0" x:Name="VaultFooter">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PasswordListSummary}" Style="{StaticResource Secondary}" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="M12,2 L21,6 L20,17 Q17,22 12,24 Q7,22 4,17 L3,6 Z M7,12 L11,16 L17,9" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Width="18" Height="21" Stretch="Uniform" Margin="0,0,10,0"/>
              <TextBlock Text="{loc:Text T_9338f02fd12a}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{loc:Text Menu.VaultHint}"/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="DuplicateSummaryText" Text="{Binding DuplicateSummary}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DuplicateSummary}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="1">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
        </StackPanel>
      </Grid>
      <Grid x:Name="FilesWorkspace" Grid.Row="1" Background="{DynamicResource ChromeBrush}">
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Page}" Value="4">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Visibility" Value="Collapsed"/>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
