                <TextBlock Text="{loc:Text Redesign.EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                  <Button Click="OnOpenArchive" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0" AutomationProperties.Name="{loc:Text Redesign.OpenArchive}">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M1,5 L8,5 L11,8 L23,8 L23,22 L1,22 Z" Width="18" Height="20" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,10,0"/>
                      <TextBlock Text="{loc:Text Redesign.OpenArchive}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Click="OnCreateFromFiles" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text Redesign.AddForCompression}">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M3,1 L13,1 L20,8 L20,25 L3,25 Z M13,1 L13,8 L20,8 M7,16 L16,16 M12,11 L12,21" Width="18" Height="20" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,10,0"/>
                      <TextBlock Text="{loc:Text Redesign.AddForCompression}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock Text="{loc:Text Redesign.EmptyHint}" Style="{StaticResource Secondary}" Margin="0,20,0,0" TextAlignment="Center"/>
              </StackPanel>
              <ContentControl x:Name="ArchiveHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
          </Border>
          <Border x:Name="ArchivePreviewPane" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed" Margin="0">
            <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </Border>
        </Grid>
        <ContentControl x:Name="ArchiveHeaderHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
      <Grid x:Name="ToolsWorkspace" Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Page}" Value="5">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Visibility" Value="Collapsed"/>
          </Style>
        </Grid.Style>
        <ContentControl x:Name="ToolsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
