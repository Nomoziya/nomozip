<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.FileKindIcon" x:Name="IconRoot" Focusable="False" IsHitTestVisible="False" Width="24" Height="28" xmlns:loc="clr-namespace:ArchivePassword.Desktop">
  <UserControl.Template>
    <ControlTemplate TargetType="{x:Type loc:FileKindIcon}">
      <Viewbox Stretch="Uniform">
        <Grid Width="24" Height="28">
          <Grid x:Name="Document">
            <Path x:Name="Page" Data="M3,1 L15,1 L22,8 L22,27 L3,27 Z" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
            <Path x:Name="Fold" Data="M15,1 L15,8 L22,8" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.4"/>
            <Path x:Name="Lines" Data="M7,13 L18,13 M7,17 L18,17 M7,21 L18,21" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.2"/>
            <TextBlock x:Name="Mark" Foreground="{DynamicResource IconOnFillBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,6,0,0" Visibility="Collapsed"/>
<Path x:Name="Zipper" Data="M12,2 L12,17 M9,5 L12,5 M9,8 L12,8 M9,11 L12,11 M15,20 A3,3 0 1 1 9,20 A3,3 0 1 1 15,20" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Grid>
          <Grid x:Name="Folder" Visibility="Collapsed" VerticalAlignment="Center" Height="20">
            <Path Data="M1,2 Q1,0 3,0 L9,0 L12,3 L21,3 Q23,3 23,5 L23,18 Q23,20 21,20 L3,20 Q1,20 1,18 Z" Fill="{DynamicResource FolderIconBrush}"/>
            <Path Data="M1,7 L23,7 L23,18 Q23,20 21,20 L3,20 Q1,20 1,18 Z" Fill="{DynamicResource FolderIconBrush}" Stroke="{DynamicResource FolderIconBrush}" StrokeThickness="1"/>
          </Grid>
          <Grid x:Name="Picture" Visibility="Collapsed" Height="21" VerticalAlignment="Center">
            <Rectangle RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
            <Ellipse Width="5" Height="5" Fill="{DynamicResource IconOnFillBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0"/>
            <Path Data="M1,18 L8,9 L14,15 L18,11 L23,18 L23,20 L1,20 Z" Fill="{DynamicResource SuccessBrush}"/>
          </Grid>
        </Grid>
      </Viewbox>
      <ControlTemplate.Triggers>
        <Trigger Property="IconKind" Value="folder">
          <Setter TargetName="Document" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Folder" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IconKind" Value="image">
          <Setter TargetName="Document" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Picture" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IconKind" Value="pdf">
          <Setter TargetName="Page" Property="Fill" Value="{DynamicResource PdfIconBrush}"/>
          <Setter TargetName="Page" Property="Stroke" Value="{DynamicResource PdfIconBrush}"/>
          <Setter TargetName="Lines" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Mark" Property="Text" Value="PDF"/>
          <Setter TargetName="Mark" Property="FontSize" Value="8"/>
          <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IconKind" Value="sheet">
          <Setter TargetName="Page" Property="Fill" Value="{DynamicResource SheetIconBrush}"/>
          <Setter TargetName="Page" Property="Stroke" Value="{DynamicResource SheetIconBrush}"/>
          <Setter TargetName="Lines" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Mark" Property="Text" Value="X"/>
          <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IconKind" Value="archive"><Setter TargetName="Fold" Property="Data" Value="M14,1 L14,9 L22,9"/>
          <Setter TargetName="Page" Property="Data" Value="M5,1 Q2,1 2,4 L2,24 Q2,27 5,27 L19,27 Q22,27 22,24 L22,9 L14,1 Z"/><Setter TargetName="Page" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
          <Setter TargetName="Page" Property="Stroke" Value="{DynamicResource SecondaryBrush}"/>
          <Setter TargetName="Lines" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Zipper" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Mark" Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </UserControl.Template>
</UserControl>
