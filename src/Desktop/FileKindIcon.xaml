<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" x:Class="ArchivePassword.Desktop.FileKindIcon" x:Name="IconRoot" Focusable="False" IsHitTestVisible="False" Width="20" Height="20">
  <UserControl.Template><ControlTemplate TargetType="{x:Type loc:FileKindIcon}"><Grid>
    <Grid x:Name="Document"><loc:FluentIcon x:Name="DocumentGlyph" Kind="DocumentText" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
    <Grid x:Name="Folder" Visibility="Collapsed"><loc:FluentIcon Kind="Folder" Foreground="{DynamicResource FolderIconBrush}"/></Grid>
    <Grid x:Name="Picture" Visibility="Collapsed"><loc:FluentIcon Kind="Image" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
  </Grid><ControlTemplate.Triggers>
    <Trigger Property="IconKind" Value="folder"><Setter TargetName="Document" Property="Visibility" Value="Collapsed"/><Setter TargetName="Folder" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IconKind" Value="image"><Setter TargetName="Document" Property="Visibility" Value="Collapsed"/><Setter TargetName="Picture" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IconKind" Value="archive"><Setter TargetName="DocumentGlyph" Property="Kind" Value="Archive"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></UserControl.Template>
</UserControl>
