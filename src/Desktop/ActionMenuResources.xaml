<?xml version="1.0" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Flat command menus share their entire surface, not only the item rows. -->
  <Style x:Key="ActionMenuItem" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,8">
              <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
            </Border>
            <Border x:Name="ItemFocus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="3" Margin="2" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Property="Icon" Value="{x:Null}">
              <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectionBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ItemFocus" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
              <Setter TargetName="ItemSurface" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Right-click rows: same surface, plus a quiet shortcut column. Availability is decided by RowActions.Tidy. -->
  <Style x:Key="ContextActionItem" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,7">
              <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
            </Border>
            <Border x:Name="ItemFocus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Margin="2" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Property="Icon" Value="{x:Null}">
              <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectionBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ItemFocus" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
              <Setter TargetName="ItemSurface" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ContextPrimaryItem" TargetType="MenuItem" BasedOn="{StaticResource ContextActionItem}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style x:Key="ContextDangerItem" TargetType="MenuItem" BasedOn="{StaticResource ContextActionItem}">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
  </Style>
  <Style x:Key="ActionMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ActionMenuSeparator" TargetType="Separator">
    <Setter Property="Height" Value="9"/>
    <Setter Property="Margin" Value="8,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{DynamicResource DividerBrush}" Height="1" VerticalAlignment="Center"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
