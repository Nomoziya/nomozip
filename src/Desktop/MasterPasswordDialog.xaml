<Window x:Class="ArchivePassword.Desktop.MasterPasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Width="480" Height="530" MinWidth="360" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
      <StackPanel x:Name="CurrentPanel"><Label Content="当前主密码" Target="{Binding ElementName=CurrentBox}" Padding="0"/><PasswordBox x:Name="CurrentBox" AutomationProperties.Name="当前主密码" PasswordChanged="OnPasswordChanged" Margin="0,8,0,16"/></StackPanel>
      <StackPanel x:Name="NewPanel"><Label Content="新主密码" Target="{Binding ElementName=NewBox}" Padding="0"/><PasswordBox x:Name="NewBox" AutomationProperties.Name="新主密码" PasswordChanged="OnPasswordChanged" Margin="0,8,0,16"/><Label Content="再次输入新主密码" Target="{Binding ElementName=ConfirmBox}" Padding="0"/><PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="再次输入新主密码" PasswordChanged="OnPasswordChanged" Margin="0,8,0,16"/></StackPanel>
      <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,12,0"/><Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnContinue"/></WrapPanel>
  </Grid>
</Window>
