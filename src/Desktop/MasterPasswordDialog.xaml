<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.MasterPasswordDialog" Style="{StaticResource AppWindow}" Width="640" Height="480" MinWidth="520" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,24">
            <Path Data="M4,13 L24,13 L24,30 L4,30 Z M8,13 L8,8 A6,6 0 0 1 20,8 L20,13 M14,20 L14,25" Width="30" Height="34" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" DockPanel.Dock="Left" Margin="0,0,16,0"/>
            <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="Description" Style="{StaticResource Secondary}" Margin="0,0,0,16"/>
          <StackPanel x:Name="CurrentPanel">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_5ee7b0789fb7}" Target="{Binding ElementName=CurrentBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <PasswordBox x:Name="CurrentBox" AutomationProperties.Name="{loc:Text T_5ee7b0789fb7}" PasswordChanged="OnPasswordChanged" Margin="0" Grid.Column="1"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="NewPanel">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_1cdcd2c700d0}" Target="{Binding ElementName=NewBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <PasswordBox x:Name="NewBox" AutomationProperties.Name="{loc:Text T_1cdcd2c700d0}" PasswordChanged="OnPasswordChanged" Margin="0" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Content="{loc:Text T_598941f23ed0}" Target="{Binding ElementName=ConfirmBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="{loc:Text T_598941f23ed0}" PasswordChanged="OnPasswordChanged" Margin="0" Grid.Column="1"/>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
        <WrapPanel HorizontalAlignment="Right" Margin="0">
          <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnContinue" Margin="0,0,12,0" MinWidth="136"/>
          <Button Content="{loc:Text T_2cd0f3be8738}" IsCancel="True" Margin="0" MinWidth="100"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</Window>
