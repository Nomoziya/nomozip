<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop" x:Class="ArchivePassword.Desktop.ExistingFileDialog" Style="{StaticResource AppWindow}" Title="{loc:Text Conflict.Title}" Width="620" Height="Auto" MinWidth="540" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" SizeToContent="Height">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <loc:FluentIcon Kind="Warning" Foreground="{DynamicResource AccentBrush}" Width="34" Height="34" Margin="0,0,16,0"/>
          <TextBlock Text="{loc:Text Conflict.Title}" VerticalAlignment="Center" Style="{StaticResource PageTitle}"/>
        </StackPanel>
        <TextBlock Text="{loc:Text Conflict.Description}" TextWrapping="Wrap" Margin="0,0,0,24"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{loc:Text Conflict.Existing}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <loc:FileKindIcon x:Name="ExistingFileIcon" Width="34" Height="42"/>
                  <Image x:Name="ExistingThumbnail" Width="44" Height="44" Stretch="UniformToFill" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="ExistingName" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="ExistingDetails" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{loc:Text Conflict.Incoming}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <loc:FileKindIcon x:Name="IncomingFileIcon" Width="34" Height="42"/>
                  <Image x:Name="IncomingThumbnail" Width="44" Height="44" Stretch="UniformToFill" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="IncomingName" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="IncomingDetails" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
          <CheckBox x:Name="ApplyAll" Content="{loc:Text Conflict.ApplyAll}" Margin="0,0,0,16"/>
          <StackPanel x:Name="RenamePanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Text Conflict.NewName}" Margin="0,0,0,6"/>
            <TextBox x:Name="NewName" AutomationProperties.Name="{loc:Text Conflict.NewName}"/>
            <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,14,0,0">
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="ReplaceButton" MinWidth="100" Content="{loc:Text Conflict.Replace}" Style="{StaticResource PrimaryButton}" Click="OnReplace" Margin="0,0,8,4" MinHeight="40"/>
          <Button MinWidth="100" Content="{loc:Text Conflict.Skip}" Click="OnSkip" Margin="0,0,8,4" MinHeight="40"/>
          <Button x:Name="RenameButton" MinWidth="100" Content="{loc:Text Conflict.Rename}" Click="OnRename" Margin="0,0,8,4" MinHeight="40"/>
          <Button Content="{loc:Text Conflict.Cancel}" IsCancel="True" Margin="0,0,0,4" MinHeight="40"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</Window>
