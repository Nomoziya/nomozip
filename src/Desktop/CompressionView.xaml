<?xml version="1.0" ?>
<UserControl xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.CompressionView">
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
    <StackPanel Margin="34,45,24,47" Height="38">
      <StackPanel Orientation="Horizontal">
        <loc:FluentIcon Kind="Archive" Width="34" Height="34" Foreground="{DynamicResource AccentBrush}" Margin="0,0,31,0"/>
        <TextBlock Text="{loc:Text Redesign.CreateArchive}" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitle}"/>
      </StackPanel>
    </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" x:Name="CompressionViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
      <Grid x:Name="CompressionLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="0"/>
          <ColumnDefinition x:Name="SettingsColumn" Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="ListRow" Height="*"/>
          <RowDefinition x:Name="SettingsRow" Height="0"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceCard}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource WorkspaceCard}" Padding="16,10" Margin="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
              <WrapPanel>
                <Button Command="{Binding AddCompressionFilesCommand}" AutomationProperties.Name="{loc:Text T_e8166a5ae76c}" Margin="0,0,8,4" Style="{StaticResource PrimaryButton}">
                  <StackPanel Orientation="Horizontal">
                    <loc:FluentIcon Kind="Add" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="{loc:Text T_ad9daebe00dc}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding AddCompressionFolderCommand}" AutomationProperties.Name="{loc:Text T_45da2d9c85d1}" Margin="0,0,8,4" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}">
                  <StackPanel Orientation="Horizontal">
                    <loc:FluentIcon Kind="FolderAdd" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="{loc:Text T_45da2d9c85d1}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding RemoveCompressionSourceCommand}" Margin="0,0,8,4" x:Name="CompressionRemoveButton">
                  <StackPanel Orientation="Horizontal">
                    <loc:FluentIcon Kind="Delete" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="{loc:Text T_a194128b2939}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="DropHint" Text="{loc:Text Menu.SourceHint}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,4" Visibility="Collapsed"/>
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding CompressionSources}" SelectedItem="{Binding SelectedCompressionSource}" RowHeight="36" AutomationProperties.Name="{loc:Text T_3514845d4419}" IsEnabled="{Binding IsIdle}" loc:RowActions.Enabled="True" loc:RowActions.DeleteCommand="{Binding RemoveCompressionSourceCommand}" x:Name="CompressionSourceTable" SelectionMode="Extended" SelectionUnit="FullRow" PreviewMouseLeftButtonDown="OnSourceSelectionMouseDown">
              <DataGrid.ContextMenu>
                <ContextMenu x:Name="SourceContextMenu" Style="{StaticResource ActionMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{loc:Text T_3514845d4419}">
                  <MenuItem x:Name="SourceAddFilesAction" Style="{StaticResource ContextActionItem}" Header="{loc:Text T_ad9daebe00dc}" Command="{Binding AddCompressionFilesCommand}"/>
                  <MenuItem x:Name="SourceAddFolderAction" Style="{StaticResource ContextActionItem}" Header="{loc:Text T_45da2d9c85d1}" Command="{Binding AddCompressionFolderCommand}"/>
                  <Separator Style="{StaticResource ActionMenuSeparator}"/>
                  <MenuItem x:Name="SourceRemoveAction" Style="{StaticResource ContextDangerItem}" Header="{loc:Text T_a194128b2939}" InputGestureText="Del" Command="{Binding RemoveCompressionSourceCommand}"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                  <Setter Property="ToolTip" Value="{Binding Path}"/>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" CanUserSort="False">
                  <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle>
                  <DataGridTemplateColumn.Header>
                    <CheckBox x:Name="SourceSelectAll" Width="18" IsThreeState="True" Checked="OnSourceSelectAll" Unchecked="OnSourceSelectAll" Margin="0" AutomationProperties.Name="{loc:Text Compression.SelectAllSources}"/>
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox Width="18" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow},Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{loc:Text Compression.SelectSource}" ToolTip="{loc:Text Compression.SelectionHint}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Text T_d44e9b3d3b31}" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <loc:FileKindIcon FileName="{Binding Path}" IsDirectory="{Binding IsDirectory}" Width="22" Height="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Text T_301a69c74dfc}" Binding="{Binding SizeText}" Width="110" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="{loc:Text T_ba40014ff496}" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource TableText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="{loc:Text T_e7a740c073cb}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompressionSources.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="2" Text="{Binding CompressionSourceSummary}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectedCompressionSource.Path}" Margin="20,14,12,14"/>
          </Grid>
        </Border>
        <Border x:Name="SettingsPanel" Grid.Column="2" Style="{StaticResource WorkspaceCard}" Padding="24,12,24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsForm" Grid.IsSharedSizeScope="True" Width="{Binding ViewportWidth,ElementName=SettingsScroll}" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="{loc:Text T_f5358f6b735d}" Style="{StaticResource Heading}" FontSize="16"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text Redesign.SaveLocation}" Target="{Binding ElementName=ArchiveOutputBox}" Padding="0" Margin="0" VerticalAlignment="Center"/>
                <TextBox x:Name="ArchiveOutputBox" Text="{Binding CompressionOutputDirectory}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text Redesign.SaveLocation}" Margin="0" Grid.Column="2"/>
                <Button Content="{loc:Text T_5a4540c9b21b}" Command="{Binding BrowseCompressionOutputCommand}" HorizontalAlignment="Left" Margin="0" Grid.Column="4" Padding="12,8"/>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text Redesign.ArchiveName}" Target="{Binding ElementName=ArchiveNameBox}" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="ArchiveNameBox" Text="{Binding CompressionOutputName}" IsEnabled="{Binding IsIdle}" Margin="0" AutomationProperties.Name="{loc:Text Redesign.ArchiveName}" Grid.Column="2"/>
              </Grid>
              <Grid x:Name="CompressionChoices" Margin="0,2,0,12" Width="{Binding ActualWidth,ElementName=SettingsForm}" MaxWidth="364" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="148"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="{loc:Text T_0e8b1c78c5f3}" Target="{Binding ElementName=FormatBox}" Padding="0" Margin="0,0,0,6"/>
                <Label x:Name="LevelLabel" Grid.Column="2" Content="{loc:Text T_e7e4273dd4c8}" Target="{Binding ElementName=LevelBox}" Padding="0" Margin="0,0,0,6">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <AccessText Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <ComboBox Grid.Row="1" x:Name="FormatBox" SelectedIndex="{Binding CompressionFormat}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_5e30948d6a8b}" Margin="0" ToolTip="{Binding CompressionHint}">
                  <ComboBoxItem Content="7z"/>
                  <ComboBoxItem Content="ZIP"/>
                  <ComboBoxItem Content="TAR"/>
                  <ComboBoxItem Content="GZIP"/>
                  <ComboBoxItem Content="XZ"/>
                </ComboBox>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LevelBox" SelectedIndex="{Binding CompressionLevel}" IsEnabled="{Binding CanSetCompressionLevel}" AutomationProperties.Name="{loc:Text T_e7e4273dd4c8}" Margin="0">
                  <ComboBoxItem Content="{loc:Text T_bfa903605147}"/>
                  <ComboBoxItem Content="{loc:Text T_db945cfe9f9f}"/>
                  <ComboBoxItem Content="{loc:Text T_6bea77acefb3}"/>
                  <ComboBoxItem Content="{loc:Text T_dfbad24e7f4a}"/>
                  <ComboBoxItem Content="{loc:Text T_8672864e9041}"/>
                </ComboBox>
              </Grid>
              <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="{loc:Text Compression.EncryptionLabel}" Padding="0" VerticalAlignment="Center" MinWidth="64" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding CompressionPasswordSummary}" Style="{StaticResource Secondary}" ToolTip="{Binding CompressionPasswordStatus}" Grid.Column="1" VerticalAlignment="Center"/>
                <Button Content="{loc:Text Compression.PasswordShort}" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource SelectionTextBrush}" Command="{Binding SetCompressionPasswordCommand}" HorizontalAlignment="Left" Margin="12,0,0,0" Grid.Column="2" Padding="12,8"/>
              </Grid>
              <TextBlock x:Name="FormatSourceError" Text="{Binding CompressionSourceError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CompressionSourceError}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                <Expander x:Name="AdvancedOptions" IsExpanded="True" Margin="0,16,0,12">
                  <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text Compression.AdvancedTitle}" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding CompressionAdvancedSummary}" Style="{StaticResource Caption}" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding CompressionAdvancedSummary}"/></Grid></Expander.Header>
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="VolumeLabelColumn" Width="72"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Label Margin="0,0,8,0" Content="{loc:Text Compression.VolumeSize}" Target="{Binding ElementName=VolumeOptionBox}" Padding="0" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="VolumeOptionBox" Style="{StaticResource CompactOptionField}" SelectedIndex="{Binding CompressionVolumeOption}" IsEnabled="{Binding CanSplitCompression}" AutomationProperties.Name="{loc:Text T_a49163724694}" ToolTip="{loc:Text T_b3b8e461c196}">
                        <ComboBoxItem Content="{loc:Text T_13fa566b385e}"/>
                        <ComboBoxItem Content="100 MiB"/>
                        <ComboBoxItem Content="1 GiB"/>
                        <ComboBoxItem Content="4 GiB"/>
                        <ComboBoxItem Content="{loc:Text T_4eafa9e925b3}"/>
                      </ComboBox>
                    </Grid>
                    <StackPanel x:Name="CustomVolumePanel">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CompressionVolumeOption}" Value="4">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <Label Content="{loc:Text T_861a9645de18}" Target="{Binding ElementName=VolumeSizeBox}" Padding="0" Margin="0,8,0,8"/>
                      <Grid Width="220" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VolumeSizeBox" Text="{Binding CompressionVolumeCustom,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_9b3b93d7e3fd}"/>
                        <ComboBox Grid.Column="2" x:Name="VolumeUnitBox" SelectedIndex="{Binding CompressionVolumeUnit}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_a536dcaf5cef}">
                          <ComboBoxItem Content="MiB"/>
                          <ComboBoxItem Content="GiB"/>
                        </ComboBox>
                      </Grid>
                      <TextBlock x:Name="VolumeError" Text="{Binding CompressionVolumeError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CompressionVolumeHint}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CompressionVolumeHint}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SfxLabelColumn" Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Label Content="{loc:Text Compression.SelfExtract}" Padding="0" VerticalAlignment="Center"/>
                      <CheckBox Grid.Column="1" x:Name="SfxBox" Content="{loc:Text T_b0b03f8b05a5}" IsChecked="{Binding CompressionSfx}" IsEnabled="{Binding CanUseSfx}" AutomationProperties.Name="{loc:Text T_872f46af0698}" ToolTip="{Binding CompressionSfxHint}" ToolTipService.ShowOnDisabled="True">
                        <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate>
                      </CheckBox>
                    </Grid>
                    <TextBlock x:Name="AdvancedAvailability" Text="{loc:Text Compression.AdvancedAvailability}" Style="{StaticResource Secondary}" Margin="72,4,0,0"/>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ParametersLabelColumn" Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Label Content="{loc:Text Compression.Parameters}" Padding="0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{loc:Text Compression.GeneratedParameters}" AutomationProperties.Name="{loc:Text Compression.Parameters}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="EncryptBox" Content="{loc:Text T_b4de1e4ddf02}" IsChecked="{Binding CompressionEncrypt}" IsEnabled="{Binding CanEncryptCompression}" Margin="72,12,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" x:Name="CompressionFooterLayout">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="FooterSettingsColumn" Width="320"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="CompressionActionsPanel" Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,0" Padding="24,16,24,16">
        <Grid x:Name="CompressionActionsRoot">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="CreateButton" Content="{loc:Text T_e185d04bcc5f}" Command="{Binding CreateArchiveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{loc:Text T_78deea3a0b97}" MinHeight="40" Margin="0,0,12,8" MinWidth="124"/>
            <Button Content="{loc:Text T_2cd0f3be8738}" Click="OnBackFiles" Margin="0,0,8,8" MinWidth="96" MinHeight="40">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="{loc:Text T_7b9e83a283ae}" Command="{Binding CancelCommand}" Margin="0,0,12,8">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="{loc:Text T_348e2fde4e19}" Command="{Binding OpenCreatedArchiveFolderCommand}" Margin="0,0,0,8" x:Name="OpenCreatedFolderButton">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </WrapPanel>
          <ProgressBar Grid.Row="2" Value="{Binding CompressionPercent, Mode=OneWay}" IsIndeterminate="{Binding CompressionIndeterminate}" Height="6" Margin="0,0,0,8" AutomationProperties.Name="{loc:Text T_317cb00c1275}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <TextBlock Grid.Row="3" Text="{Binding CompressionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CompressionMessage}" Value="{loc:Text T_d576b99c6465}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding CompressionOutput}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompressionOutput}" Margin="0,0,0,12" Grid.Row="0" HorizontalAlignment="Left" MaxWidth="420"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
