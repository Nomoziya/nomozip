<UserControl x:Class="ArchivePassword.Desktop.CompressionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="压缩" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="创建 7z 或 ZIP。文件与文件夹保留各自名称，校验成功后才保存压缩包。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel><TextBlock Text="要压缩的内容" Style="{StaticResource Heading}"/>
            <WrapPanel Margin="0,0,0,12"><Button Content="添加文件" Command="{Binding AddCompressionFilesCommand}" AutomationProperties.Name="添加要压缩的文件" Margin="0,0,12,8"/><Button Content="添加文件夹" Command="{Binding AddCompressionFolderCommand}" Margin="0,0,12,8"/><Button Content="移除所选" Command="{Binding RemoveCompressionSourceCommand}" Margin="0,0,0,8"/></WrapPanel>
            <Grid Height="176"><DataGrid ItemsSource="{Binding CompressionSources}" SelectedItem="{Binding SelectedCompressionSource}" AutomationProperties.Name="待压缩内容" IsEnabled="{Binding IsIdle}"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"/></DataGrid.Columns></DataGrid>
              <TextBlock Text="尚未添加内容。可点击添加，或将文件/文件夹拖到此页。" TextWrapping="Wrap" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionSources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid><TextBlock Text="{Binding SelectedCompressionSource.Path}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="压缩设置" Style="{StaticResource Heading}"/>
          <Label Content="格式" Target="{Binding ElementName=FormatBox}" Padding="0"/><ComboBox x:Name="FormatBox" SelectedIndex="{Binding CompressionFormat}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="压缩格式" Margin="0,8,0,12"><ComboBoxItem Content="7z"/><ComboBoxItem Content="ZIP"/></ComboBox>
          <Label Content="压缩级别" Target="{Binding ElementName=LevelBox}" Padding="0"/><ComboBox x:Name="LevelBox" SelectedIndex="{Binding CompressionLevel}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="压缩级别" Margin="0,8,0,12"><ComboBoxItem Content="仅存储"/><ComboBoxItem Content="快速"/><ComboBoxItem Content="标准"/><ComboBoxItem Content="较高"/><ComboBoxItem Content="最高"/></ComboBox>
          <Label Content="新压缩包位置" Target="{Binding ElementName=ArchiveOutputBox}" Padding="0"/><TextBox x:Name="ArchiveOutputBox" Text="{Binding CompressionOutput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="新压缩包完整路径" Margin="0,8,0,8"/><Button Content="选择保存位置" Command="{Binding BrowseCompressionOutputCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
          <CheckBox Content="使用密码加密" IsChecked="{Binding CompressionEncrypt}" IsEnabled="{Binding IsIdle}"/>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionEncrypt}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="{Binding CompressionPasswordStatus}" Style="{StaticResource Secondary}"/><Button Content="设置或更换密码" Command="{Binding SetCompressionPasswordCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <CheckBox Content="加密文件名（仅 7z）" IsChecked="{Binding CompressionHeaders}" IsEnabled="{Binding Is7zCompression}"/>
          </StackPanel>
          <TextBlock Text="{Binding CompressionHint}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="8" Margin="0,12,0,0">
      <StackPanel><TextBlock Text="{Binding CompressionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar Value="{Binding CompressionPercent, Mode=OneWay}" IsIndeterminate="{Binding CompressionIndeterminate}" Height="6" Margin="0,8,0,12" AutomationProperties.Name="压缩进度"/>
        <WrapPanel><Button x:Name="CreateButton" Content="创建压缩包" Command="{Binding CreateArchiveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="创建压缩包，Control Shift C" MinHeight="44" Margin="0,0,12,8"/><Button Content="取消压缩" Command="{Binding CancelCommand}" IsEnabled="{Binding CompressionRunning}" Margin="0,0,12,8"/><Button Content="打开所在目录" Command="{Binding OpenCreatedArchiveFolderCommand}" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
