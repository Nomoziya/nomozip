<UserControl x:Class="ArchivePassword.Desktop.CompressionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="压缩" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="添加文件或文件夹，选择格式和保存位置后开始。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><DockPanel>
      <Button Content="添加文件" Command="{Binding AddCompressionFilesCommand}" AutomationProperties.Name="添加要压缩的文件" DockPanel.Dock="Left"/>
      <Button Content="添加文件夹" Command="{Binding AddCompressionFolderCommand}" DockPanel.Dock="Left" Margin="12,0,0,0"/>
      <Button Content="移除所选" Command="{Binding RemoveCompressionSourceCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
      <TextBlock x:Name="DropHint" Text="也可以将内容拖入此窗口" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0"/>
    </DockPanel></Border>
    <ScrollViewer Grid.Row="2" x:Name="CompressionViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="CompressionLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="SettingsColumn" Width="280"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="SettingsRow" Height="0"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="要压缩的内容" Style="{StaticResource Heading}"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding CompressionSources}" SelectedItem="{Binding SelectedCompressionSource}" RowHeight="48" AutomationProperties.Name="待压缩内容" IsEnabled="{Binding IsIdle}">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource TableText}"/></DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Text="添加文件、文件夹或拖入内容" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionSources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Grid.Row="2" Text="{Binding SelectedCompressionSource.Path}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectedCompressionSource.Path}" Margin="8,16,0,0"/>
        </Grid></Border>
        <Border x:Name="SettingsPanel" Grid.Column="2" Style="{StaticResource Card}">
          <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="压缩设置" Style="{StaticResource Heading}"/>
            <Label Content="新压缩包位置" Target="{Binding ElementName=ArchiveOutputBox}" Padding="0"/><TextBox x:Name="ArchiveOutputBox" Text="{Binding CompressionOutput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="新压缩包完整路径" Margin="0,8,0,8"/><Button Content="选择保存位置" Command="{Binding BrowseCompressionOutputCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><Label Content="格式" Target="{Binding ElementName=FormatBox}" Padding="0"/><ComboBox x:Name="FormatBox" SelectedIndex="{Binding CompressionFormat}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="压缩格式" Margin="0,8,0,0"><ComboBoxItem Content="7z"/><ComboBoxItem Content="ZIP"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><Label Content="压缩级别" Target="{Binding ElementName=LevelBox}" Padding="0"/><ComboBox x:Name="LevelBox" SelectedIndex="{Binding CompressionLevel}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="压缩级别" Margin="0,8,0,0"><ComboBoxItem Content="仅存储"/><ComboBoxItem Content="快速"/><ComboBoxItem Content="标准"/><ComboBoxItem Content="较高"/><ComboBoxItem Content="最高"/></ComboBox></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Label Content="分卷" Target="{Binding ElementName=VolumeOptionBox}" Padding="0" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="VolumeOptionBox" SelectedIndex="{Binding CompressionVolumeOption}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="分卷大小，M 表示 MiB，G 表示 GiB" ToolTip="M 表示 MiB，G 表示 GiB；1 MiB = 1048576 字节。"><ComboBoxItem Content="不分卷"/><ComboBoxItem Content="100 MiB"/><ComboBoxItem Content="1 GiB"/><ComboBoxItem Content="4 GiB"/><ComboBoxItem Content="自定义"/></ComboBox></Grid>
            <StackPanel x:Name="CustomVolumePanel"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionVolumeOption}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <Label Content="每卷大小（整数）" Target="{Binding ElementName=VolumeSizeBox}" Padding="0" Margin="0,8,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="VolumeSizeBox" Text="{Binding CompressionVolumeCustom,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="自定义每卷大小，正整数"/><ComboBox Grid.Column="2" x:Name="VolumeUnitBox" SelectedIndex="{Binding CompressionVolumeUnit}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="分卷大小单位"><ComboBoxItem Content="MiB"/><ComboBoxItem Content="GiB"/></ComboBox></Grid>
              <TextBlock x:Name="VolumeError" Text="{Binding CompressionVolumeError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <TextBlock Text="{Binding CompressionVolumeHint}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Style.Triggers><DataTrigger Binding="{Binding CompressionVolumeHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <CheckBox Content="使用密码加密" IsChecked="{Binding CompressionEncrypt}" IsEnabled="{Binding IsIdle}"/>
            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionEncrypt}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="{Binding CompressionPasswordStatus}" Style="{StaticResource Secondary}"/><Button Content="设置或更换密码" Command="{Binding SetCompressionPasswordCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <CheckBox Content="加密文件名（仅 7z）" IsChecked="{Binding CompressionHeaders}" IsEnabled="{Binding Is7zCompression}"/>
            </StackPanel>
            <TextBlock Text="{Binding CompressionHint}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="CreateButton" Content="创建压缩包" Command="{Binding CreateArchiveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="创建压缩包，Control Shift C" MinHeight="44" Margin="0,0,12,8"/>
        <Button Content="取消压缩" Command="{Binding CancelCommand}" Margin="0,0,12,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Content="打开所在目录" Command="{Binding OpenCreatedArchiveFolderCommand}" Margin="0,0,0,8"/>
      </WrapPanel>
      <ProgressBar Grid.Row="1" Value="{Binding CompressionPercent, Mode=OneWay}" IsIndeterminate="{Binding CompressionIndeterminate}" Height="6" Margin="0,0,0,8" AutomationProperties.Name="压缩进度"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CompressionRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
      <TextBlock Grid.Row="2" Text="{Binding CompressionMessage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</UserControl>
