              <Label Content="{loc:Text T_861a9645de18}" Target="{Binding ElementName=VolumeSizeBox}" Padding="0" Margin="0,8,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="VolumeSizeBox" Text="{Binding CompressionVolumeCustom,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_9b3b93d7e3fd}"/><ComboBox Grid.Column="2" x:Name="VolumeUnitBox" SelectedIndex="{Binding CompressionVolumeUnit}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_a536dcaf5cef}"><ComboBoxItem Content="MiB"/><ComboBoxItem Content="GiB"/></ComboBox></Grid>
