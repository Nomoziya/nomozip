<?xml version="1.0" ?>
<UserControl xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.CompressionView">
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="24,24,24,20">
      <TextBlock Text="{loc:Text Redesign.CreateArchive}" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Text T_4e66c76ffe75}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding CompressionOutput}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompressionOutput}" Margin="0,0,0,12"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="CompressionViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
      <Grid x:Name="CompressionLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="0"/>
          <ColumnDefinition x:Name="SettingsColumn" Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="ListRow" Height="*"/>
          <RowDefinition x:Name="SettingsRow" Height="0"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceCard}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource WorkspaceCard}" Padding="16,10" Margin="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
              <WrapPanel>
                <Button Content="{loc:Text T_ad9daebe00dc}" Command="{Binding AddCompressionFilesCommand}" AutomationProperties.Name="{loc:Text T_e8166a5ae76c}" Margin="0,0,8,4"/>
                <Button Content="{loc:Text T_45da2d9c85d1}" Command="{Binding AddCompressionFolderCommand}" Margin="0,0,8,4"/>
                <Button Content="{loc:Text T_a194128b2939}" Command="{Binding RemoveCompressionSourceCommand}" Margin="0,0,8,4"/>
                <TextBlock x:Name="DropHint" Text="{loc:Text Menu.SourceHint}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,4" Visibility="Collapsed"/>
              </WrapPanel>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding CompressionSources}" SelectedItem="{Binding SelectedCompressionSource}" RowHeight="48" AutomationProperties.Name="{loc:Text T_3514845d4419}" IsEnabled="{Binding IsIdle}" loc:RowActions.Enabled="True" loc:RowActions.DeleteCommand="{Binding RemoveCompressionSourceCommand}">
              <DataGrid.ContextMenu>
                <ContextMenu x:Name="SourceContextMenu" Style="{StaticResource ActionMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{loc:Text T_3514845d4419}">
                  <MenuItem x:Name="SourceAddFilesAction" Style="{StaticResource ContextActionItem}" Header="{loc:Text T_ad9daebe00dc}" Command="{Binding AddCompressionFilesCommand}"/>
                  <MenuItem x:Name="SourceAddFolderAction" Style="{StaticResource ContextActionItem}" Header="{loc:Text T_45da2d9c85d1}" Command="{Binding AddCompressionFolderCommand}"/>
                  <Separator Style="{StaticResource ActionMenuSeparator}"/>
                  <MenuItem x:Name="SourceRemoveAction" Style="{StaticResource ContextDangerItem}" Header="{loc:Text T_a194128b2939}" InputGestureText="Del" Command="{Binding RemoveCompressionSourceCommand}"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                  <Setter Property="ToolTip" Value="{Binding Path}"/>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Text T_d44e9b3d3b31}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="{loc:Text T_ba40014ff496}" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource TableText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="{loc:Text T_e7a740c073cb}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompressionSources.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="2" Text="{Binding SelectedCompressionSource.Path}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectedCompressionSource.Path}" Margin="8,16,0,0"/>
          </Grid>
        </Border>
        <Border x:Name="SettingsPanel" Grid.Column="2" Style="{StaticResource WorkspaceCard}" Padding="24" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{loc:Text T_f5358f6b735d}" Style="{StaticResource Heading}"/>
              <Label Content="{loc:Text Redesign.SaveLocation}" Target="{Binding ElementName=ArchiveOutputBox}" Padding="0"/>
              <TextBox x:Name="ArchiveOutputBox" Text="{Binding CompressionOutputDirectory}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text Redesign.SaveLocation}" Margin="0,8,0,8"/>
              <Button Content="{loc:Text T_edfa33a3f470}" Command="{Binding BrowseCompressionOutputCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
              <StackPanel Margin="0,0,0,16">
                <Label Content="{loc:Text Redesign.ArchiveName}" Target="{Binding ElementName=ArchiveNameBox}" Padding="0"/>
                <TextBox x:Name="ArchiveNameBox" Text="{Binding CompressionOutputName}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0" AutomationProperties.Name="{loc:Text Redesign.ArchiveName}"/>
              </StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="{loc:Text T_0e8b1c78c5f3}" Target="{Binding ElementName=FormatBox}" Padding="0"/>
                <Label x:Name="LevelLabel" Grid.Column="0" Content="{loc:Text T_e7e4273dd4c8}" Target="{Binding ElementName=LevelBox}" Padding="0" Grid.Row="1" VerticalAlignment="Center">
                  <Label.ContentTemplate>
                    <DataTemplate>
                      <AccessText Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </Label.ContentTemplate>
                </Label>
                <ComboBox Grid.Row="0" x:Name="FormatBox" SelectedIndex="{Binding CompressionFormat}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_5e30948d6a8b}" Margin="0,0,0,12" Grid.Column="2">
                  <ComboBoxItem Content="7z"/>
                  <ComboBoxItem Content="ZIP"/>
                  <ComboBoxItem Content="TAR"/>
                  <ComboBoxItem Content="GZIP"/>
                  <ComboBoxItem Content="XZ"/>
                </ComboBox>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LevelBox" SelectedIndex="{Binding CompressionLevel}" IsEnabled="{Binding CanSetCompressionLevel}" AutomationProperties.Name="{loc:Text T_e7e4273dd4c8}" Margin="0,0,0,12">
                  <ComboBoxItem Content="{loc:Text T_bfa903605147}"/>
                  <ComboBoxItem Content="{loc:Text T_db945cfe9f9f}"/>
                  <ComboBoxItem Content="{loc:Text T_6bea77acefb3}"/>
                  <ComboBoxItem Content="{loc:Text T_dfbad24e7f4a}"/>
                  <ComboBoxItem Content="{loc:Text T_8672864e9041}"/>
                </ComboBox>
              </Grid>
              <CheckBox x:Name="EncryptBox" Content="{loc:Text T_b4de1e4ddf02}" IsChecked="{Binding CompressionEncrypt}" IsEnabled="{Binding CanEncryptCompression}"/>
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CompressionEncrypt}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding CompressionPasswordStatus}" Style="{StaticResource Secondary}"/>
                <Button Content="{loc:Text T_fa762d29f739}" Command="{Binding SetCompressionPasswordCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <CheckBox Content="{loc:Text T_6df0322e460d}" IsChecked="{Binding CompressionHeaders}" IsEnabled="{Binding Is7zCompression}"/>
              </StackPanel>
              <TextBlock Text="{Binding CompressionHint}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="FormatSourceError" Text="{Binding CompressionSourceError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CompressionSourceError}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Expander Header="{loc:Text Redesign.Advanced}" Margin="0,16,0,12">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="0,0,8,0" Content="{loc:Text T_5473b9b24a75}" Target="{Binding ElementName=VolumeOptionBox}" Padding="0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="VolumeOptionBox" SelectedIndex="{Binding CompressionVolumeOption}" IsEnabled="{Binding CanSplitCompression}" AutomationProperties.Name="{loc:Text T_a49163724694}" ToolTip="{loc:Text T_b3b8e461c196}">
                      <ComboBoxItem Content="{loc:Text T_13fa566b385e}"/>
                      <ComboBoxItem Content="100 MiB"/>
                      <ComboBoxItem Content="1 GiB"/>
                      <ComboBoxItem Content="4 GiB"/>
                      <ComboBoxItem Content="{loc:Text T_4eafa9e925b3}"/>
                    </ComboBox>
                  </Grid>
                  <StackPanel x:Name="CustomVolumePanel">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CompressionVolumeOption}" Value="4">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Label Content="{loc:Text T_861a9645de18}" Target="{Binding ElementName=VolumeSizeBox}" Padding="0" Margin="0,8,0,8"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="VolumeSizeBox" Text="{Binding CompressionVolumeCustom,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_9b3b93d7e3fd}"/>
                      <ComboBox Grid.Column="2" x:Name="VolumeUnitBox" SelectedIndex="{Binding CompressionVolumeUnit}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:Text T_a536dcaf5cef}">
                        <ComboBoxItem Content="MiB"/>
                        <ComboBoxItem Content="GiB"/>
                      </ComboBox>
                    </Grid>
                    <TextBlock x:Name="VolumeError" Text="{Binding CompressionVolumeError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                  <TextBlock Text="{Binding CompressionVolumeHint}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CompressionVolumeHint}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <CheckBox x:Name="SfxBox" Content="{loc:Text T_b0b03f8b05a5}" IsChecked="{Binding CompressionSfx}" IsEnabled="{Binding CanUseSfx}" AutomationProperties.Name="{loc:Text T_872f46af0698}"/>
                  <TextBlock Text="{Binding CompressionSfxHint}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CompressionSfxHint}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="24,16,24,20" x:Name="CompressionActionsRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="CreateButton" Content="{loc:Text T_e185d04bcc5f}" Command="{Binding CreateArchiveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{loc:Text T_78deea3a0b97}" MinHeight="44" Margin="0,0,12,8"/>
        <Button Content="{loc:Text T_2cd0f3be8738}" Click="OnBackFiles" Margin="0,0,8,8">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="{loc:Text T_7b9e83a283ae}" Command="{Binding CancelCommand}" Margin="0,0,12,8">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="{loc:Text T_348e2fde4e19}" Command="{Binding OpenCreatedArchiveFolderCommand}" Margin="0,0,0,8"/>
      </WrapPanel>
      <ProgressBar Grid.Row="1" Value="{Binding CompressionPercent, Mode=OneWay}" IsIndeterminate="{Binding CompressionIndeterminate}" Height="6" Margin="0,0,0,8" AutomationProperties.Name="{loc:Text T_317cb00c1275}">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CompressionRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>
      <TextBlock Grid.Row="2" Text="{Binding CompressionMessage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</UserControl>
