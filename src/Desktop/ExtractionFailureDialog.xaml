<Window x:Class="ArchivePassword.Desktop.ExtractionFailureDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="解压失败详情" Width="760" Height="500" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock x:Name="ResultHeading" Text="失败条目" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ArchiveName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock x:Name="ResultSummary" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="ContextDescription" Text="本次解压未完成。以下为最后一次检查或暂存处理的结果，不能计为解压完成。" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><DataGrid x:Name="FailureTable" RowHeight="48" AutomationProperties.Name="解压失败条目列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns>
      <DataGridTextColumn Header="包内路径" Binding="{Binding Path}" Width="*" MinWidth="150" ElementStyle="{StaticResource TableText}"/>
      <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="180" ElementStyle="{StaticResource TableText}"/>
    </DataGrid.Columns></DataGrid></Border>
    <Button Grid.Row="2" Content="关闭" IsCancel="True" Click="OnClose" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
