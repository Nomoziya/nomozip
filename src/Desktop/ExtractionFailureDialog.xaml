<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ExtractionFailureDialog" Style="{StaticResource AppWindow}" Title="{loc:Text T_fa9d33365735}" Width="720" Height="480" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <DockPanel Margin="0,0,0,24">
          <Path x:Name="ResultIcon" Data="M14,1 A13,13 0 1 1 13.9,1 M14,7 L14,16 M14,20 L14,22" Width="30" Height="34" Stretch="Uniform" Stroke="{DynamicResource ErrorBrush}" StrokeThickness="2" DockPanel.Dock="Left" Margin="0,0,16,0"/>
          <TextBlock x:Name="ResultHeading" Text="{loc:Text T_1f45f5276e0b}" FontSize="24" FontWeight="SemiBold" Margin="0" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ArchiveName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        <TextBlock x:Name="ResultSummary" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="ContextDescription" Text="{loc:Text T_04e76a15f886}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
        <DataGrid x:Name="FailureTable" RowHeight="48" AutomationProperties.Name="{loc:Text T_640f915421fe}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Text T_7e6b31a9f368}" Binding="{Binding Path}" Width="*" MinWidth="150" ElementStyle="{StaticResource TableText}"/>
            <DataGridTextColumn Header="{loc:Text T_f029d9cb4a76}" Binding="{Binding Reason}" Width="180" ElementStyle="{StaticResource TableText}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Button Grid.Row="2" Content="{loc:Text T_3fd47edce45b}" IsCancel="True" Click="OnClose" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
  </Border>
</Window>
