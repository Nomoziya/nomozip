<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArchivePassword.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Width" Value="50"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource ErrorBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="IntegratedWindowTemplate" TargetType="Window">
    <Grid>
    <Border x:Name="WindowInset" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="7">
      <Grid>
        <AdornerDecorator><ContentPresenter/></AdornerDecorator>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="{local:Text Window.Minimize}" ToolTip="{local:Text Window.Minimize}">
            <Path Data="M1,6 L11,6" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="12" Height="12"/>
          </Button>
          <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="{local:Text Window.Maximize}" ToolTip="{local:Text Window.Maximize}">
            <Path x:Name="MaximizeGlyph" Data="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="12" Height="12"/>
          </Button>
          <Button x:Name="CaptionClose" Tag="Close" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="{local:Text Window.Close}" ToolTip="{local:Text Window.Close}">
            <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="12" Height="12"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="local:WindowChromeBehavior.ShowSystemButtons" Value="False"><Setter TargetName="CaptionMinimize" Property="Visibility" Value="Collapsed"/><Setter TargetName="CaptionMaximize" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="MaximizeGlyph" Property="Data" Value="M3.5,1.5 L10.5,1.5 L10.5,8.5 M1.5,3.5 L8.5,3.5 L8.5,10.5 L1.5,10.5 Z"/><Setter TargetName="CaptionMaximize" Property="AutomationProperties.Name" Value="{local:Text Window.Restore}"/><Setter TargetName="CaptionMaximize" Property="ToolTip" Value="{local:Text Window.Restore}"/><Setter TargetName="WindowInset" Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
