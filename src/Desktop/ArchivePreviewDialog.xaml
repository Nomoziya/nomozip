<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ArchivePreviewDialog" Style="{StaticResource AppWindow}" Title="{loc:Text Preview.Title}" Width="900" Height="600" MinWidth="480" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12,12" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8">
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="OnClose" Padding="6" Width="28" Height="28" MinHeight="28" AutomationProperties.Name="{loc:Text Redesign.ClosePreview}" ToolTip="{loc:Text Redesign.ClosePreview}">
          <Path Data="M1,1 L11,11 M11,1 L1,11" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.2"/>
        </Button>
        <TextBlock Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntryPath}" Margin="0" VerticalAlignment="Center" Style="{StaticResource PageTitle}"/>
      </DockPanel>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,16,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
              <Setter Property="Text" Value="{loc:Text Preview.Title}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter Property="Text" Value="{loc:Text Preview.ImageTitle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
      <TextBlock x:Name="PreviewDetails" Text="{Binding Details}" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceCard}" Padding="0" Margin="0">
      <Grid>
        <TextBox x:Name="PreviewText" Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Microsoft YaHei UI" AutomationProperties.Name="{loc:Text Preview.TextName}" VerticalContentAlignment="Top" BorderThickness="0" Padding="12" Background="{DynamicResource CanvasBrush}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsText}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="PreviewError" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel VerticalAlignment="Top">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Image x:Name="PreviewImage" Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="{Binding EntryPath}" VerticalAlignment="Top" MaxHeight="300">
            <Image.Style>
              <Style TargetType="Image">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Image.Style>
          </Image>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{loc:Text Preview.Dimensions}" Style="{StaticResource Secondary}"/>
              <TextBlock Grid.Column="1" Text="{Binding PixelDimensions}"/>
              <TextBlock Grid.Row="1" Text="{loc:Text Contents.CompactSize}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Margin="0,8,0,0"/>
              <TextBlock Grid.Row="2" Text="{loc:Text Browser.Modified}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModifiedText}" Margin="0,8,0,0"/>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,16,0,0" ToolTip="{loc:Text Preview.Notice}">
      <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Ellipse Fill="{DynamicResource SuccessBrush}"/><Path Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{DynamicResource IconOnFillBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
      <TextBlock x:Name="PreviewNotice" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="OpenPreviewButton" Command="{Binding OpenImageCommand}" MinHeight="40" Margin="0,0,12,0" HorizontalAlignment="Stretch" ToolTip="{loc:Text Preview.OpenHint}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><Path Data="M9,2 L16,2 L16,9 M16,2 L7,11 M6,4 L2,4 L2,16 L14,16 L14,12" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{loc:Text Preview.OpenImage}"/></StackPanel></Button>
      <Button x:Name="ClosePreviewButton" Grid.Column="1" Content="{loc:Text Redesign.ClosePreview}" IsCancel="True" IsDefault="True" Click="OnClose" MinHeight="40" HorizontalAlignment="Stretch"/>
    </Grid>
  </Grid>
</Window>
