<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ArchivePreviewDialog" Style="{StaticResource AppWindow}" Title="{loc:Text Preview.Title}" Width="900" Height="600" MinWidth="480" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,16" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8">
      <TextBlock Text="{loc:Text Preview.Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
      <TextBlock Text="{Binding EntryPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntryPath}" FontWeight="SemiBold" Margin="0,6,0,8" FontSize="20"/>
      <TextBlock x:Name="PreviewDetails" Text="{Binding Details}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceCard}" Padding="0" Margin="0,16,0,0">
      <Grid>
        <TextBox x:Name="PreviewText" Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Microsoft YaHei UI" AutomationProperties.Name="{loc:Text Preview.TextName}" VerticalContentAlignment="Top" BorderThickness="0" Padding="12" Background="{DynamicResource CanvasBrush}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsText}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <Image x:Name="PreviewImage" Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="{Binding EntryPath}" VerticalAlignment="Top" MaxHeight="300">
          <Image.Style>
            <Style TargetType="Image">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Image.Style>
        </Image>
        <TextBlock x:Name="PreviewError" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
    <TextBlock x:Name="PreviewNotice" Grid.Row="2" Text="{loc:Text Preview.Notice}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <Button x:Name="ClosePreviewButton" Grid.Row="3" Content="{loc:Text Redesign.ClosePreview}" IsCancel="True" IsDefault="True" Click="OnClose" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
  </Grid>
</Window>
