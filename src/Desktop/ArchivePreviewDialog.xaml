<?xml version="1.0" ?>
<Window xmlns:loc="clr-namespace:ArchivePassword.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ArchivePassword.Desktop.ArchivePreviewDialog" Style="{StaticResource AppWindow}" Title="{loc:Text Preview.Title}" Width="900" Height="600" MinWidth="480" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,16" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8">
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="OnClose" Padding="6" Width="32" Height="32" AutomationProperties.Name="{loc:Text Redesign.ClosePreview}" ToolTip="{loc:Text Redesign.ClosePreview}">
          <Path Data="M2,2 L16,16 M16,2 L2,16" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.7"/>
        </Button>
        <TextBlock Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntryPath}" FontWeight="SemiBold" Margin="0" FontSize="16" VerticalAlignment="Center"/>
      </DockPanel>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{loc:Text Preview.Title}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter Property="Text" Value="{loc:Text Preview.ImageTitle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
      <TextBlock x:Name="PreviewDetails" Text="{Binding Details}" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceCard}" Padding="0" Margin="0">
      <Grid>
        <TextBox x:Name="PreviewText" Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Microsoft YaHei UI" AutomationProperties.Name="{loc:Text Preview.TextName}" VerticalContentAlignment="Top" BorderThickness="0" Padding="12" Background="{DynamicResource CanvasBrush}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsText}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="PreviewError" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel VerticalAlignment="Top">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Image x:Name="PreviewImage" Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="{Binding EntryPath}" VerticalAlignment="Top" MaxHeight="300">
            <Image.Style>
              <Style TargetType="Image">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Image.Style>
          </Image>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{loc:Text Preview.Dimensions}" Style="{StaticResource Secondary}"/>
              <TextBlock Grid.Column="1" Text="{Binding PixelDimensions}"/>
              <TextBlock Grid.Row="1" Text="{loc:Text Contents.CompactSize}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Margin="0,8,0,0"/>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" ToolTip="{loc:Text Preview.Notice}">
      <Path Data="M20,10 A10,10 0 1 1 0,10 A10,10 0 1 1 20,10 M5,10 L9,14 L15,6" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center">
        <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
      </Path>
      <TextBlock x:Name="PreviewNotice" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Text Preview.Loaded}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="{loc:Text Preview.Notice}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <Button x:Name="ClosePreviewButton" Grid.Row="3" Content="{loc:Text Redesign.ClosePreview}" IsCancel="True" IsDefault="True" Click="OnClose" HorizontalAlignment="Right" MinWidth="128" Margin="0,12,0,0"/>
  </Grid>
</Window>
