<Window x:Class="ArchivePassword.Desktop.ExtractionRulesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="解压规则" Width="540" Height="630" MinWidth="400" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20" KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="解压规则" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="选择文件放在哪里，以及是否需要新建目录。" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer x:Name="RulesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Label Content="位置预设" Target="{Binding ElementName=LocationBox}" Padding="0"/><ComboBox x:Name="LocationBox" SelectedIndex="{Binding Location}" AutomationProperties.Name="解压位置预设" Margin="0,8,0,12"><ComboBoxItem Content="自定义目录"/><ComboBoxItem Content="每个压缩包所在目录"/><ComboBoxItem Content="桌面"/><ComboBoxItem Content="文档"/></ComboBox>
      <Label Content="自定义目录" Target="{Binding ElementName=CustomPathBox}" Padding="0"/><ComboBox x:Name="CustomPathBox" IsEditable="True" ItemsSource="{Binding RecentPaths}" Text="{Binding CustomPath,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustom}" AutomationProperties.Name="自定义解压目录或最近使用目录" Margin="0,8,0,12"/>
      <Label Content="目录规则" Target="{Binding ElementName=LayoutBox}" Padding="0"/><ComboBox x:Name="LayoutBox" SelectedIndex="{Binding Layout}" AutomationProperties.Name="解压目录规则" Margin="0,8,0,8"><ComboBoxItem Content="直接放入所选位置"/><ComboBoxItem Content="每包新建目录"/><ComboBoxItem Content="智能目录"/></ComboBox>
      <TextBlock Text="智能目录：单个文件或已有一个根目录时直接放入所选位置；多项散放时新建容器。已有根目录按同名文件策略合并。" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Label Content="容器命名" Target="{Binding ElementName=NamingBox}" Padding="0"/><ComboBox x:Name="NamingBox" SelectedIndex="{Binding Naming}" IsEnabled="{Binding UsesContainer}" AutomationProperties.Name="新建解压目录命名" Margin="0,8,0,12"><ComboBoxItem Content="压缩包名"/><ComboBoxItem Content="压缩包名_日期"/></ComboBox>
      <Label Content="新建目录重名时" Target="{Binding ElementName=CollisionBox}" Padding="0"/><ComboBox x:Name="CollisionBox" SelectedIndex="{Binding Collision}" IsEnabled="{Binding UsesContainer}" AutomationProperties.Name="新建解压目录重名处理" Margin="0,8,0,12"><ComboBoxItem Content="创建新编号目录，如名称 (2)"/><ComboBoxItem Content="合并到已有目录，沿用同名文件策略"/></ComboBox>
      <CheckBox x:Name="OpenAfterBox" Content="整批解压成功后打开结果目录" IsChecked="{Binding OpenAfterSuccess}" Margin="0,0,0,8"/><TextBlock Text="多个不同目录会显示结果位置列表，由你选择打开；失败或取消不自动打开。" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><WrapPanel HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,8,12,0"/><Button x:Name="ApplyRulesButton" Content="应用规则" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnApply" Margin="0,8,0,0"/></WrapPanel></StackPanel>
  </Grid>
</Window>
