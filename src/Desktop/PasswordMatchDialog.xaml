<Window x:Class="ArchivePassword.Desktop.PasswordMatchDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ArchivePassword.Desktop"
        Style="{StaticResource AppWindow}" Title="{loc:Text PasswordMatch.Title}" Width="820" Height="560" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Text PasswordMatch.Title}" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="{Binding ArchiveName}" ToolTip="{Binding ArchivePath}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding Notice}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <DataGrid x:Name="MatchTable" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" RowHeight="NaN" MinRowHeight="72" ColumnHeaderHeight="32" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Text PasswordMatch.Order}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="52" ElementStyle="{StaticResource TableText}"/>
          <DataGridTemplateColumn Header="{loc:Text PasswordMatch.Reason}" Width="*">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Margin="10,8">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Group}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding Group}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding History}" TextWrapping="Wrap" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding History}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
        <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGrid.RowStyle>
      </DataGrid>
      <TextBlock Text="{loc:Text PasswordMatch.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button x:Name="CloseMatchButton" Grid.Row="3" Content="{loc:Text Compression.CloseContents}" Click="OnClose" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
